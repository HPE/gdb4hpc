#

maint set sync on

#
# Launch our processes
#

launch $broken{4} hpcc_broken
launch $working{4} hpcc_working

#
# Set error tolerance
#
set error 1.0e-14 1.0e-13 absolute

#
# This decomposition allows us to do a rank-wise comparison of scalar variables
#
decomposition $scalar
	dimension 4
	distribute block
	proc_grid 4
end

#
# We know that the calculation of XnormI is wrong since it deviates. Lets blindly compare every variable
# that goes into this calculation.
#
# Note that mat.X is a bit more complicated to compare, and is done below in the assertion script $XnormI_matX.
#

build $XnormI
	assert $scalar{$broken::*GRID@"HPL_pdtest.c":357} == $scalar{$working::*GRID@"HPL_pdtest.c":357}
	assert $scalar{$broken::N@"HPL_pdtest.c":357} == $scalar{$working::N@"HPL_pdtest.c":357}
	assert $scalar{$broken::NB@"HPL_pdtest.c":357} == $scalar{$working::NB@"HPL_pdtest.c":357}
	assert $scalar{$broken::*GRID@"HPL_pdtest.c":359} == $scalar{$working::*GRID@"HPL_pdtest.c":359}
	assert $scalar{$broken::N@"HPL_pdtest.c":359} == $scalar{$working::N@"HPL_pdtest.c":359}
	assert $scalar{$broken::NB@"HPL_pdtest.c":359} == $scalar{$working::NB@"HPL_pdtest.c":359}
end

start $XnormI

info script $XnormI results

#
# mat.X is the 1 by nq solution vector x. This points to a region inside of mat.A to avoid uneeded reallocation
# of memory. We can use gdb4hpc to break at line 357 and print the value of nq.
#
# We find the following for both working and broken for nq:
# a[1,3]: 480
# a[0,2]: 520
#
# If we think about this in terms of the global problem, we would expect the global solution vector x to be
# 1 by 1000. However when we reconstruct what each rank is pointing at, we have enough "space" for a 1 by 2000
# vector. Note that mat.X does simply point into the local A matrix, however if we were truly interested in only
# comparing the bits that HPL_pdlange operates on, we need to figure out which ranks it will use to calculate
# the norm value.
#
# If we look at the code for the function HPL_pdlange, we see that the HPL_NORM_1 only does operations for ranks that
# an mp that is greater than 0. If we set a break at HPL_pdtest.c:357, continue to the breakpoint, set a breakpoint
# at HPL_pdlange.c:164 (which is the start of the HPL_NORM_1 calculation) and then issue a print on mp, we find the
# following for both working and broken:
# a[2-3]: 0
# a[0-1]: 1
#
# This means that rank 0 and rank 1 hold onto the actual information for mat.X. We should only compare those two ranks.
#
# We need to cast the dereferenced mat.X pointer to the proper dimension so that gdb4hpc is able to grab the amount of
# data we are expecting. C language does not provide a way for us to determine this directly from the pointer alone!
#

#
# Restart the applications so that we can run another script
#
run

build $XnormI_matX
	assert $broken::(double[520])(*mat.X)@"HPL_pdtest.c":357 == $working::(double[520])(*mat.X)@"HPL_pdtest.c":357
	assert $broken{0}::(double[520])(*mat.X)@"HPL_pdtest.c":357 == $working{0}::(double[520])(*mat.X)@"HPL_pdtest.c":357
	assert $broken{0}::(double[520])(*mat.X)@"HPL_pdtest.c":359 == $working{0}::(double[520])(*mat.X)@"HPL_pdtest.c":359
	assert $broken{1}::(double[480])(*mat.X)@"HPL_pdtest.c":357 == $working{1}::(double[480])(*mat.X)@"HPL_pdtest.c":357
	assert $broken{1}::(double[480])(*mat.X)@"HPL_pdtest.c":359 == $working{1}::(double[480])(*mat.X)@"HPL_pdtest.c":359
end

start $XnormI_matX

info script $XnormI_matX results

#
# RESULT:
#
# After running $XnormI we find that there is no deviation before or after the call to XnormI. This means that we can 
# safely ignore all of these variables since they are not the source of deviation.
#
# After running $XnormI_matX we find that mat.X is different *before* the call to XnormI. The original source of deviation 
# must occur earlier.
#
