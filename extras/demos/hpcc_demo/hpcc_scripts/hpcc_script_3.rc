#

maint set sync on

#
# Launch our processes
#

launch $broken{4} hpcc_broken
launch $working{4} hpcc_working

#
# Set error tolerance
#
set error 1.0e-14 1.0e-13 absolute

#
# This decomposition allows us to do a rank-wise comparison of scalar variables
#
decomposition $scalar
	dimension 4
	distribute block
	proc_grid 4
end

#
# Since resid0 deviates, lets check every variable that goes into the function which calculates its value.
#
# Note that Bptr is a bit more complicated to compare, and is done below in the assertion script $resid0_Bptr.
#

build $resid0
	assert $scalar{$broken::*GRID@"HPL_pdtest.c":407} == $scalar{$working::*GRID@"HPL_pdtest.c":407}
	assert $scalar{$broken::N@"HPL_pdtest.c":407} == $scalar{$working::N@"HPL_pdtest.c":407}
	assert $scalar{$broken::NB@"HPL_pdtest.c":407} == $scalar{$working::NB@"HPL_pdtest.c":407}
	assert $scalar{$broken::mat.ld@"HPL_pdtest.c":407} == $scalar{$working::mat.ld@"HPL_pdtest.c":407}
	assert $scalar{$broken::*GRID@"HPL_pdtest.c":409} == $scalar{$working::*GRID@"HPL_pdtest.c":409}
	assert $scalar{$broken::N@"HPL_pdtest.c":409} == $scalar{$working::N@"HPL_pdtest.c":409}
	assert $scalar{$broken::NB@"HPL_pdtest.c":409} == $scalar{$working::NB@"HPL_pdtest.c":409}
	assert $scalar{$broken::mat.ld@"HPL_pdtest.c":409} == $scalar{$working::mat.ld@"HPL_pdtest.c":409}
end

start $resid0

info script $resid0 results

#
# Bptr is the global N by 1 b matrix. Bptr points to a region inside of mat.A to avoid uneeded reallocation of
# memory. We can use gdb4hpc to break at HPL_pdtest.c:407, continue to the breakpoint, set a breakpoint at 
# HPL_pdlange.c:200 (which is the start of the HPL_NORM_I calculation) and then issue a print on mp and nq
# to get the following:
#
# dbg all> print mp
# a[2-3]: 480
# a[0-1]: 520
#
# dbg all> print nq
# a[1,3]: 0
# a[0,2]: 1
#
# This means that ranks 0 and 2 hold onto the actual information for Bptr. We should only compare those two ranks.
# Rank 0 contains 520 elements of b. Rank 2 contains 480 elements of b.
#
# We need to cast the dereferenced Bptr pointer to the proper dimension so that gdb4hpc is able to grab the amount of
# data we are expecting. C language does not provide a way for us to determine this directly from a pointer alone!
#

run

build $resid0_Bptr
	assert $broken::(double[520])(*Bptr)@"HPL_pdtest.c":407 == $working::(double[520])(*Bptr)@"HPL_pdtest.c":407
	assert $broken{0}::(double[520])(*Bptr)@"HPL_pdtest.c":407 == $working{0}::(double[520])(*Bptr)@"HPL_pdtest.c":407
	assert $broken{0}::(double[520])(*Bptr)@"HPL_pdtest.c":409 == $working{0}::(double[520])(*Bptr)@"HPL_pdtest.c":409
	assert $broken{2}::(double[480])(*Bptr)@"HPL_pdtest.c":407 == $working{2}::(double[480])(*Bptr)@"HPL_pdtest.c":407
	assert $broken{2}::(double[480])(*Bptr)@"HPL_pdtest.c":409 == $working{2}::(double[480])(*Bptr)@"HPL_pdtest.c":409
end

start $resid0_Bptr

info script $resid0_Bptr results

# 
# RESULT:
#
# After running $resid0 we find that there is no deviation before or after the call for resid0. This means that we can
# safely ignore all of these variables since they are not the source of deviation.
#
# After running $resid0_Bptr we find that Bptr is different *before* the call for resid0. The original source of deviation
# must occur earlier.
#
