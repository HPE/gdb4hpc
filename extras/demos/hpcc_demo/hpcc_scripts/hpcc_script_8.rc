maint set sync on

#
# Launch our processes
#

launch $broken{4} hpcc_broken
launch $working{4} hpcc_working

#
# Set error tolerance
#
set error 1.0e-14 1.0e-13 absolute

# Lets start by blindly comparing the scalar inputs to the HPL_dgemm function call.

build $dgemm
	assert $broken::ORDER@"HPL_dgemm.c":467 == $working::ORDER@"HPL_dgemm.c":467
	assert $broken::ORDER@"HPL_dgemm.c":467 == $working::ORDER@"HPL_dgemm.c":467
	assert $broken::TRANSA@"HPL_dgemm.c":467 == $working::TRANSA@"HPL_dgemm.c":467
	assert $broken::TRANSB@"HPL_dgemm.c":467 == $working::TRANSB@"HPL_dgemm.c":467
	assert $broken::M@"HPL_dgemm.c":467 == $working::M@"HPL_dgemm.c":467
	assert $broken::N@"HPL_dgemm.c":467 == $working::N@"HPL_dgemm.c":467
	assert $broken::K@"HPL_dgemm.c":467 == $working::K@"HPL_dgemm.c":467
	assert $broken::ALPHA@"HPL_dgemm.c":467 == $working::ALPHA@"HPL_dgemm.c":467
	assert $broken::LDA@"HPL_dgemm.c":467 == $working::LDA@"HPL_dgemm.c":467
	assert $broken::LDB@"HPL_dgemm.c":467 == $working::LDB@"HPL_dgemm.c":467
	assert $broken::BETA@"HPL_dgemm.c":467 == $working::BETA@"HPL_dgemm.c":467
	assert $broken::LDC@"HPL_dgemm.c":467 == $working::LDC@"HPL_dgemm.c":467
end

start $dgemm

info script $dgemm results

# RESULT:
#
# Note that there was 1 sucessful assertion set iteration. Meaning that the HPL_dgemm was called at some point
# in the control flow before it was called at line 382 of HPL_pdupdateTT.c without failure. We did detect a
# difference between ALPHA and BETA which correspond to assertID's 7 and 10 respectively. We can verify when this
# took place by issuing the backtrace (or bt) command after the assertion script interpreter halts.
#
# dbg all> bt														
# broken[0,2-3]: *** program is running										      
# broken[1]: #0  0x000000000042a488 in HPL_dgemm at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/blas/HPL_dgemm.c:467	
# broken[1]: #1  0x0000000000432561 in HPL_pdupdateTT at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/pgesv/HPL_pdupdateTT.c:382
# broken[1]: #2  0x000000000044f69e in HPL_pdgesvK2 at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/pgesv/HPL_pdgesvK2.c:178    
# broken[1]: #3  0x0000000000432706 in HPL_pdgesv at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/pgesv/HPL_pdgesv.c:107	
# broken[1]: #4  0x000000000040fbce in HPL_pdtest at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/testing/ptest/HPL_pdtest.c:200    
# broken[1]: #5  0x000000000040a1ad in HPL_main at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/testing/ptest/HPL_pddriver.c:228    
# broken[1]: #6  0x0000000000402434 in main at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/src/hpcc.c:309			      
# working[0,2-3]: *** program is running											
# working[1]: #0  0x000000000042a488 in HPL_dgemm at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/blas/HPL_dgemm.c:467	  
# working[1]: #1  0x0000000000432561 in HPL_pdupdateTT at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/pgesv/HPL_pdupdateTT.c:382
# working[1]: #2  0x000000000044f69e in HPL_pdgesvK2 at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/pgesv/HPL_pdgesvK2.c:178    
# working[1]: #3  0x0000000000432706 in HPL_pdgesv at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/src/pgesv/HPL_pdgesv.c:107	
# working[1]: #4  0x000000000040fbce in HPL_pdtest at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/testing/ptest/HPL_pdtest.c:200    
# working[1]: #5  0x000000000040a1ad in HPL_main at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/hpl/testing/ptest/HPL_pddriver.c:228    
# working[1]: #6  0x0000000000402434 in main at /lus/nid00030/pjm/Cascade/hpcc-1.4.1/src/hpcc.c:309
#
# This verifys that we made the call to HPL_dgemm at line 382 of HPL_pdupdateTT.c as we expected. We can then print the values of
# ALPHA and BETA to see what they are currently set to in both processes.
#
# dbg all> print ALPHA
# broken[0,2-3]: *** program is running
# broken[1]: 1
# working[0,2-3]: *** program is running
# working[1]: -1
# dbg all> print BETA
# broken[0,2-3]: *** program is running
# broken[1]: -1
# working[0,2-3]: *** program is running
# working[1]: 1
#
# We see that there is a sign difference for both. The creator of the broken code mistakenly reversed the sign for both ALPHA and
# BETA which led to a deviation! If we correct the mistake, recompile, and re-run TM_script_1 the codes are no longer deviating. The
# problem goes away.

