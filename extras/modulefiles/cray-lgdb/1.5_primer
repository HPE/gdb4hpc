#%Module
set 	home 		%HOME%
set	level		%VERSION%.DEV

# NOTE: LD_LIBRARY_PATH is no longer set in the module for the alps libraries. 
# Instead the proper search path is encoded directly into the binary rpath.
# For development purposes, LD_LIBRARY_PATH can be used.
#
append-path     LD_LIBRARY_PATH                 $home/lib
prepend-path	PATH 				$home/bin
setenv          CRAY_LGDB_VERSION               $level
setenv		CRAY_LGDB_LIB_DIR		$home/lib
setenv		CRAY_CTI_CFG_DIR		~/.ccdb
setenv		GUARD_MRNET_CFG_DIRECTORY	~/.ccdb
setenv		CRAY_LD_VAL_LIBRARY		$home/lib/libaudit.so

proc ModulesHelp { } {
	puts stderr "lgdb: The Cray line mode Debugger"
}

