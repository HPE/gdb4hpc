srcdir =	@srcdir@
VPATH =		@srcdir@
prefix =	@prefix@
exec_prefix =	@exec_prefix@
bindir =	@bindir@
libdir =	@libdir@

CC =		@CC@
CPPFLAGS =	@CPPFLAGS@
CFLAGS =	@CFLAGS@
LDFLAGS =	@LDFLAGS@
DEFS =		@DEFS@
INSTALL =	@INSTALL@
INSTALL_PROGRAM =	@INSTALL_PROGRAM@
INSTALL_DATA =	@INSTALL_DATA@
RANLIB =	@RANLIB@
AR =		ar
RPCGEN =	rpcgen
REMOVE =	rm -f
XMLTO =		@XMLTO@

TOP =		$(srcdir)/../..
COMPAT =	$(srcdir)/../compat
DBGSRV =	$(srcdir)/../dbgsrv
GC =		$(srcdir)/../gc
UTIL =		$(srcdir)/../util
LIBS =	
INSPROGS =	

SHELL =		/bin/sh

all: html.stamp guard.ps guard.txt

clean:
	rm -f *.html html.stamp guard.ps

distclean: clean
	rm -f Makefile Makefile.bak

html.stamp: guard.xml
	$(XMLTO) html guard.xml
	touch html.stamp

guard.ps: guard.xml
	$(XMLTO) ps guard.xml

guard.txt: guard.xml
	$(XMLTO) txt guard.xml

# DO NOT REMOVE THIS LINE
