<GC> ::= 
	<statement-list>

<statement-list> ::= 
	{ <statement> }

<statement> ::= 
	<comment> | <invoke-statement> | <assert-statement> |
	<set-statement>

<comment> ::=
	"#" { <ASCII-character> }

<invoke-statement> ::= 
	<serial-invoke> | <parallel-invoke>

<serial-invoke> ::= 
	"invoke" <process-id> <program-name>

<parallel-invoke> ::= 
	"invoke" <mp-process-id> <program-name>
		"using" <mp-architecture-string>

<process-id> ::= 
	<identifier>

<mp-process-id> ::= 
	<identifier> "[" <digit-seq> "]"

<program-name> ::= 
	<string>

<mp-architecture-string> ::= 
	""" <mp-architecture> """

<mp-architecture> ::= 
	"poe" | "mpich"

<assert-statement> ::= 
	"assert" <variable-specifier> <equals> <variable-specfier>

<variable-specifier> ::=
	<process-id-specifier> "::" <variable> "@" <source-file>
		":" <line-number> 
	
<process-id-specifier> ::=
	<process-id> | <mp-process-id>

<variable> ::=
	<identifier> | <identifier> <array-format-specifier>

<array-format-specifier> ::=
	<slice-specfier> | <permute-specifier> | 
	<slice-specfier> <permute-specifier>

<slice-specifier> ::=
	<index-range> { <index-range> }

<index-range> ::=
	"[" <digit-seq> ".." <digit-seq> "]"

<permute-specifier> ::=
	"(" <digit-seq> { "," <digit-seq> } ")"

<source-file> ::=
	<string>

<line-number> ::=
	<digit-seq>

<set-statment> ::=
	"set" <set-option>

<set-option> ::=
	<error-value> | <display-type>

<error-value>
	"error" <lower-limit> <upper-limit> <error-type>

<lower-limit> ::=
	<float>

<upper-limit> ::=
	<float>

<error-type> ::=
	"absolute" | "relative"

<display-type> ::=
	"display" <display-type-string>

<display-type-string> ::=
	""" <display-type> """

<display-type> ::=
	"text" | "hdf"

<equals> ::=
	"=" | "=="

<string> ::=
	""" { <ASCII-character> } """

<identifier> ::= 
	"_" | <letter> | <identifier> <following-char>

<following-char> ::= 
	"_" | <letter> | <digit>

<digit-seq> ::= 
	<digit> | <digit> <digit-seq>

<digit> ::= 
	"0" .. "9"

<letter> ::= 
	"A" .. "Z" | "a" .. "z"
