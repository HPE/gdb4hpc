#ifdef HAVE_CONFIG_H
#include	<config.h>
#endif /* HAVE_CONFIG_H */

#ifndef WIN32
#include        <sys/types.h>
#include        <sys/socket.h>
#include        <netinet/in.h>
#include        <unistd.h>
#else /* !WIN32 */
#include        <windows.h>
#include        <winsock.h>
#endif /* !WIN32 */

#include	<stdio.h>
#include	<stdlib.h>
#include	<string.h>
#include	<math.h>

#include	"defs.h"
#include	"aif.h"

#ifndef WIN32
#include	<netdb.h>
#endif /* !WIN32 */

#define MAX_RANK	10

#define RED		0
#define GREEN		1
#define BLUE		2

#define NCOL		256
#define COL_WHITE	(NCOL-1)
#define COL_BLACK	0
#define COL_GREEN	49

#define MAX_DISP	100
#define HDR_LEN		64

struct
{
	double	min;
	double	max;
	int	col;
} errtab[NCOL-2];

unsigned char	cmap[NCOL][3];
SOCKET		disps[MAX_DISP];
int		idx = -1;
int		debug = 0;

void		SetColourMap(void);
void		SetColours(AIF *, char *, double);
void		GetSize(AIF *, int *, int *);
int		FindColour(double);
double		DataAsDouble(AIF *, AIFIndex *, char *);

int
InitMS(char *str, char *name, AIF *a)
{
	int			i;
	int			w;
	int			h;
	int			port;
	int			nlen;
	char *			sport;
	char *			sidx;
	unsigned char		header[HDR_LEN];
	struct hostent *        hp;
	struct sockaddr_in      in;

	if ( idx < 0 )
	{
		for ( i = 0 ; i < MAX_DISP ; i++ )
			disps[i] = INVALID_SOCKET;

		idx = 0;
	}

	if ( strcmp(str, "debug") != 0 )
	{
		if ( (sport = strchr(str, ':')) == NULL )
		{
			fprintf(stderr, "Bad name format \"%s\"\n", str);
			return -1;
		}

		*sport = '\0';

		if ( (hp = gethostbyname(str)) == (struct hostent *)NULL )
		{
			fprintf(stderr, "unknown host \"%s\"\n", str);
			return -1;
		}

		*sport++ = ':';

		if ( (sidx = strchr(sport, ':')) != NULL )
		{
			*sidx = '\0';
			port = atoi(sport);
			*sidx++ = ':';
			idx = atoi(sidx);

			if ( idx >= MAX_DISP )
			{
				fprintf(stderr, "Display count exceeded\n");
				return -1;
			}

			if ( disps[idx] != INVALID_SOCKET)
				return idx;
		}
		else
		{
			idx = 0;

			if ( disps[idx] != INVALID_SOCKET)
				return 0;

			port = atoi(sport);
		}

		if ( (disps[idx] = socket(AF_INET, SOCK_STREAM, 0)) == INVALID_SOCKET)
		{
			perror("ms: socket");
			return -1;
		}

		in.sin_family = AF_INET;
		memcpy((char *)&in.sin_addr, (char *)hp->h_addr, hp->h_length);
		in.sin_port = htons((short)port);

		if ( connect(disps[idx], (struct sockaddr *)&in, sizeof(in)) == SOCKET_ERROR )
		{
			perror("ms: connect");
			CLOSE_SOCKET(disps[idx]);
			disps[idx] = INVALID_SOCKET;
			return -1;
		}
	}
	else
	{
		disps[0] = 0;
		idx = 0;
		debug++;
	}

	SetColourMap();

	GetSize(a, &w, &h);

	nlen = (name != NULL) ? strlen(name) : 0;

	header[0] = w & 0xff;
	header[1] = (w >> 8) & 0xff;
	header[2] = h & 0xff;
	header[3] = (h >> 8) & 0xff;
	header[4] = nlen & 0xff;

	for ( i = 0 ; i < nlen ; i++ )
		header[5+i] = name[i];

	if ( debug )
	{
		printf("%dx%d\n", w, h);
	}
	else if ( send(disps[idx], header, HDR_LEN, 0) == SOCKET_ERROR )
	{
		perror("ms: write");
		CLOSE_SOCKET(disps[idx]);
		disps[idx] = INVALID_SOCKET;
		return -1;
	}

	return disps[idx];
}

void
SetColourMap(void)
{
	int	r;
	int	g;
	int	b;
	int	n = 0;

	r = 0;
	g = 0;
	b = 252;

	for ( ; g < 256 ; g += 6 )
	{
		cmap[n][RED] = r;
		cmap[n][GREEN] = g;
		cmap[n++][BLUE] = b;
	}

	for ( g = 252 ; b >= 0 ; b -= 6 )
	{
		cmap[n][RED] = r;
		cmap[n][GREEN] = g;
		cmap[n++][BLUE] = b;
	}

	for ( b = 0 ; r < 256 ; r += 6 )
	{
		cmap[n][RED] = r;
		cmap[n][GREEN] = g;
		cmap[n++][BLUE] = b;
	}
	
	for ( r = 252 ; g >= 0 ; g -= 6 )
	{
		cmap[n][RED] = r;
		cmap[n][GREEN] = g;
		cmap[n++][BLUE] = b;
	}

	for ( g = 0 ; b < 256 ; b += 6 )
	{
		cmap[n][RED] = r;
		cmap[n][GREEN] = g;
		cmap[n++][BLUE] = b;
	}

	/* White */
	cmap[COL_WHITE][RED] = 255;
	cmap[COL_WHITE][GREEN] = 255;
	cmap[COL_WHITE][BLUE] = 255;

	/* Black */
	cmap[COL_BLACK][RED] = 0;
	cmap[COL_BLACK][GREEN] = 0;
	cmap[COL_BLACK][BLUE] = 0;
}

void
SetColours(AIF *a, char *field, double error)
{
	int		i;
	int		n;
	AIFIndex *	ix;
	double		d;
	double		inc;
	double		minv = MAXDOUBLE;
	double		maxv = 0.0;

	ix = AIFArrayIndexInit(a);

	for ( i = 0 ; i < ix->i_nel ; i++ )
	{
		d = DataAsDouble(a, ix, field);

		AIFArrayIndexInc(ix);

		if ( (d = fabs(d)) <= error )
			continue;

		if ( d > maxv )
			maxv = d;

		if ( d < minv )
			minv = d;
	}

	AIFArrayIndexFree(ix);

	inc = (maxv - minv) / (double)(NCOL-2);

	for ( n = 0 ; n < NCOL-2 ; n++ )
	{
		errtab[n].col = n + 1;
		errtab[n].min = minv;
		minv += inc;
		errtab[n].max = minv;
	}

	/*
	** avoid rounding errors
	*/
	errtab[n-1].max = maxv;
}

void
GetSize(AIF *a, int *width, int *height)
{
	AIFIndex *	ix;

	ix = AIFArrayIndexInit(a);

	*width = ix->i_max[0] - ix->i_min[0] + 1;
	*height = ix->i_max[1] - ix->i_min[1] + 1;

	AIFArrayIndexFree(ix);
}

int
SendMS(AIF *a, char *field, double error)
{
	int		x;
	int		y;
	int		res;
	double		d;
	AIFIndex *	ix;

	if ( AIFType(a) != AIF_ARRAY )
	{
		fprintf(stderr, "Data must be an array.\n");
		return -1;
	}

	if ( AIFArrayRank(a) != 2 )
	{
		fprintf(stderr, "Only 2-dimensions allowed!\n");
		return -1;
	}

	SetColours(a, field, error);

	ix = AIFArrayIndexInit(a);

	for ( y = 0 ; y < ix->i_max[1] - ix->i_min[1] + 1 ; y++ )
	{
		for ( x = 0 ; x < ix->i_max[0] - ix->i_min[0] + 1 ; x++ )
		{
			res = COL_WHITE;

			d = DataAsDouble(a, ix, field);

			AIFArrayIndexInc(ix);

			if ( (d = fabs(d)) > error )
				res = FindColour(d);

			if ( debug )
			{
				printf("%x%x%x ", cmap[res][0]&0xff, cmap[res][1]&0xff, cmap[res][2]&0xff);
			}
			else if ( send(disps[idx], &cmap[res][0], 3, 0) == SOCKET_ERROR )
			{
				perror("ms: write");
				CLOSE_SOCKET(disps[idx]);
				disps[idx] = INVALID_SOCKET;
				return -1;
			}

		}

		if ( debug )
			printf("\n");
	}

	AIFArrayIndexFree(ix);

	return 0;
}

int
FindColour(double v)
{
	int	n;
	int	lo = 0;
	int	hi = NCOL-2;

	for ( ;; )
	{
		n = lo + (hi - lo) / 2;

		if ( v < errtab[n].min )
		{
			if ( n <= 0 )
				return COL_WHITE;

			hi = n;
			continue;
		}

		if ( v > errtab[n].max )
		{
			if ( n >= NCOL-2 )
				return COL_BLACK;

			lo = n;
			continue;
		}

		return errtab[n].col;
	}
}

double
DataAsDouble(AIF *a, AIFIndex *ix, char *field)
{
	int		i;
	AIF *		el;
	double		d;
	static int	first = 1;
	static int	et;

	switch ( AIFBaseType(a) )
	{
	case AIF_FLOATING:
		if ( AIFArrayElementToDouble(a, ix, &d) < 0 )
		{
			fprintf(stderr, "%s\n", AIFErrorStr());
			exit(1);
		}
		break;

	case AIF_INTEGER:
		if ( AIFArrayElementToInt(a, ix, &i) < 0 )
		{
			fprintf(stderr, "%s\n", AIFErrorStr());
			exit(1);
		}

		d = (double)i;
		break;

	case AIF_STRUCT:
		el = AIFArrayElement(a, ix);

		if ( first )
		{
			if ( field == NULL )
			{
				fprintf(stderr, "must specify field name\n");
				exit(1);
			}

			et = AIFFieldType(el, field);
			first = 0;
		}
		else
			field = NULL;

		switch ( et )
		{
		case AIF_INTEGER:
			if ( AIFFieldToInt(el, field, &i) < 0 )
			{
				fprintf(stderr, "%s\n", AIFErrorStr());
				exit(1);
			}

			d = (double)i;
			break;

		case AIF_FLOATING:
			if ( AIFFieldToDouble(el, field, &d) < 0 )
			{
				fprintf(stderr, "%s\n", AIFErrorStr());
				exit(1);
			}
			break;

		case AIF_INVALID:
			fprintf(stderr, "%s\n", AIFErrorStr());
			exit(1);

		default:
			fprintf(stderr, "type not supported\n");
			exit(1);
		}
		break;

	default:
		fprintf(stderr, "type not supported\n");
		exit(1);
	}

	return d;
}
