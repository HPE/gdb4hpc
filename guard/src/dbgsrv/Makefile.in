@GDB_BACKEND_TRUE@BACKEND = dbgsrv_gdb.c dbgrexp.c dbgsrv_util.c dbgsrv_p2p.c

# Check for idb
@IDB_BACKEND_TRUE@BACKEND = dbgsrv_idb.c dbgrexp.c
