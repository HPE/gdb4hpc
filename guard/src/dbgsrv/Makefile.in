@MRN_TRUE@MRN_SRV = dbg_mrn_be.c dbgsrv_mrn.c mrn_topo.c

# Check for Socket
@SOCK_TRUE@SOCK_SRV = dbgsrv_soc.c

# Check for gdb-mi
@GDBMI_BACKEND_TRUE@BACKEND = dbgsrv_gdbmi.c dbgsrv_libmi2aif.c dbgsrv_util.c dbgsrv_p2p.c

#####################
# Determine backend #
#####################

