#ifndef _GMAP_H
#define _GMAP_H

#include	"aif.h"
#include	"list.h"
#include	"hash.h"

struct g_map_t
{
	hentry_t *	m_sym;
	list_t *	m_args;
	var_t *		m_actual;
	int			m_debug;
	func_t *	m_index;
	func_t *	m_proc;
	int			(*m_builtin)(list_t *);

	/*
	** Fields filled in when map is being evaluated.
	*/
	int			m_current;
	AIFIndex *	m_ix;
};
typedef struct g_map_t	g_map_t;

extern void			SetMap(void);
extern g_map_t *	GetMap(void);
extern g_map_t *	FindMap(char *);
extern int			CheckMap(hentry_t *);
extern g_map_t *	NewMap(hentry_t *, list_t *);
extern void			DestroyMap(g_map_t *);
extern AIF *		ApplyMap(g_map_t *, char *, int, AIF **);
extern void			PrintMap(FILE *, g_map_t *);

#endif /* !_GMAP_H */
