#ifdef HAVE_CONFIG_H
#include        <config.h>
#endif /* HAVE_CONFIG_H */

#include	<stdarg.h>
#include	<stdio.h>
#include	<signal.h>
#include	<string.h>

#include	"defs.h"
#include	"useful.h"
#include	"aif.h"
#include	"fds.h"
#include	"gram.h"
#include 	"dbg_set_sync.h"

#define TRANS_TABLE_SIZE        7     /* 2^7 = 128 */

static htable_t *	_trans_table = (htable_t *)NULL;
static list_t *		_trans_list = (list_t *)NULL;

int	EvalTransFunc(trans_t *, func_t *, int);

/*
** Find a translation.
*/
trans_t *
FindTrans(char *trans)
{
	hentry_t *	h;

	if ( (h = HashSearch(_trans_table, trans)) != (hentry_t *)NULL )
		return (trans_t *)h->h_data;

	return (trans_t *)NULL;
}

int
CheckTrans(hentry_t *sym)
{
	trans_t *	t = FindTrans(SymLookup(sym));

	return t != (trans_t *)NULL;
}

void
SetTrans(void)
{
	if ( _trans_list != (list_t *)NULL )
		SetList(_trans_list);
}

trans_t *
GetTrans(void)
{
	if ( _trans_list == (list_t *)NULL )
		return (trans_t *)NULL;

	return (trans_t *)GetListElement(_trans_list);
}

/*
** Create a new translation.
*/
trans_t *
NewTrans(hentry_t *sym)
{
	trans_t *	t;

	t = (trans_t *)Alloc(sizeof(trans_t));
	t->t_sym = sym;
	t->t_index = (func_t *)NULL;
	t->t_builtin = (int (*)(list_t *))NULL;
	t->t_current = 0;
	t->t_debug = 0;

	if ( _trans_list == (list_t *)NULL )
		_trans_list = NewList();

	if ( _trans_table == (htable_t *)NULL )
		_trans_table = HashCreate(TRANS_TABLE_SIZE);

	if ( HashInsert(_trans_table, SymLookup(sym), (void *)t) == (hentry_t *)NULL )               
	{       
		SetError("Too many translations defined.");
		return (trans_t *)NULL;
	}

	AddToList(_trans_list, (void *)t);

	return t;
}

/*
** Free a translation.
*/
void
DestroyTrans(trans_t *t)
{
	hentry_t *	h;

	if ( t == (trans_t *)NULL )
		return;

	if ( (h = HashSearch(_trans_table, SymLookup(t->t_sym))) != (hentry_t *)NULL )
		HashRemove(_trans_table, h);

	RemoveFromList(_trans_list, (void *)t);

	if ( t->t_index != (func_t *)NULL )
		FreeFunc(t->t_index);

	Free(t);
}

AIF *
ApplyTrans(trans_t *t, AIF *type, AIF *data)
{
	int		i;
	int		ix;
	char *		s;
	char *		r_ptr=NULL;
	char *		d_ptr;
	char *		one_d_ptr;
	AIF *		res;
	AIF *		one_d;
	AIFIndex *	dix;
	AIFIndex *	rix;
	char		buf[BUFSIZ];

	if ( AIFType(data) != AIF_ARRAY || AIFType(type) != AIF_ARRAY )
	{
		SetError("Arguments to ApplyTrans must be arrays");
		return (AIF *)NULL;
	}

	/*
	** Determine array info for result
	*/
	rix = FDSArrayIndexInit(AIF_FORMAT(type));

	/*
	** Determine array info for data
	*/
	dix = AIFArrayIndexInit(data);

	if ( dix->i_nel != rix->i_nel )
	{
		SetError("Arrays are different sizes");

		AIFArrayIndexFree(dix);
		AIFArrayIndexFree(rix);

		return (AIF *)NULL;
	}

	/*
	** Create result array.
	*/
	s = buf;
	*s = '\0';

	for ( i = 0 ; i < rix->i_rank; i++ )
	{
		sprintf(s, "[r%d..%dis4]", rix->i_min[i], rix->i_max[i]);
		s = &buf[strlen(buf)];
	}

	strcat(buf, dix->i_btype);

	res = MakeAIF(strdup(buf), NULL);
	AIFArrayIndexFree(rix);
	rix = FDSArrayIndexInit(buf);

	/*
	** If data is alread 1D then we don't need to do anything.
	*/

	if ( dix->i_rank > 1 )
	{
		/*
		** Create 1D array.
		*/
		sprintf(buf, "[r0..%dis4]%s", dix->i_nel - 1, dix->i_btype);
		one_d = MakeAIF(strdup(buf), NULL);

		/*
		** First convert supplied array to 1D
		*/

		for ( i = 0 ; i < dix->i_nel ; i++ )
		{
			if ( t->t_debug )
			{
				printf("%s[%d]", SymLookup(t->t_sym), i);
				printf(" = ");
				AIFPrintArrayIndex(stdout, dix);
				printf("\n");

				AIFArrayIndexInc(dix);

				continue;
			}

			/*
			** Compute offset into data and result
			*/
			d_ptr = AIF_DATA(data) + AIFIndexOffset(dix->i_rank, dix->i_index, dix->i_min, dix->i_max, NULL) * dix->i_bsize;
			one_d_ptr = AIF_DATA(one_d) + i * dix->i_bsize;

			/*
			** Copy data into 1D array.
			*/
			memcpy(one_d_ptr, d_ptr, dix->i_bsize);

			AIFArrayIndexInc(dix);
		}
	}
	else
		one_d = data;

	AIFArrayIndexFree(dix);

	/*
	** Check if we can finish now.
	*/

	if ( t->t_index == (func_t *)NULL && rix->i_rank == 1 )
	{
		AIFArrayIndexFree(rix);

		if ( one_d != data )
			return one_d;

		return CopyAIF(data);
	}

	/*
	** Now convert 1D array to result type, applying traslation
	** function if supplied.
	*/

	for ( i = 0 ; i < rix->i_nel ; i++ )
	{
		if ( !t->t_debug )
		{
			/*
			** Compute offset into data and result
			*/
			r_ptr = AIF_DATA(res) + AIFIndexOffset(rix->i_rank, rix->i_index, rix->i_min, rix->i_max, NULL) * rix->i_bsize;
		}

		/*
		** Apply index function.
		*/

		ix = i;

		if
		(
			t->t_index != (func_t *)NULL
			&&
			(ix = EvalTransFunc(t, t->t_index, i)) < 0
		)
		{
			AIFArrayIndexFree(rix);

			if ( one_d != data )
				AIFFree(one_d);

			AIFFree(res);

			return (AIF *)NULL;
		}

		if ( !t->t_debug )
		{
			one_d_ptr = AIF_DATA(one_d) + ix * rix->i_bsize;

			/*
			** Copy data into result
			*/
			memcpy(r_ptr, one_d_ptr, rix->i_bsize);
		}
		else
		{
			printf("%s", SymLookup(t->t_sym));
			AIFPrintArrayIndex(stdout, rix);
			printf(" = [%d]", ix);
			printf("\n");
		}

		AIFArrayIndexInc(rix);
	}

	AIFArrayIndexFree(rix);

	if ( one_d != data )
		AIFFree(one_d);

	return res;
}

/*
** Evaluate translation function f(i) and return the result.
*/
int
EvalTransFunc(trans_t *t, func_t *f, int index)
{
	int		res;
	AIF *		a;
	val_t *		val;
	arg_t *		av;
	list_t *	args;

	if ( (a = IntToAIF(index)) == (AIF *)NULL )
	{
		SetError("%s", AIFErrorStr());
		return -1;
	}

	args = NewList();

	/*
	** Add index to actual args.
	*/
	val = NewVal(lval_none, rval_aif, a);
	av = NewArg(ARG_VAL, val);
	AddToList(args, (void *)av);

	if ( EvalFunc(&val, f, args, (rec_set_t *)NULL) < 0 )
	{
		SetError("Error while evaluating translation function \"%s\".", SymLookup(f->f_sym));
		DestroyList(args, DestroyArg);
		return -1;
	}

	DestroyList(args, DestroyArg);

	if ( val->val_rval_type != rval_aif )
	{
		SetError("Expression evaluated to bad type.");
		DestroyVal(val);
		return -1;
	}

	if ( AIFToInt(VAL_CONTENTS(val, (rec_set_t *)NULL), &res) < 0 )
	{
		SetError("%s", AIFErrorStr());
		DestroyVal(val);
		return -1;
	}

	DestroyVal(val);

	return res;
}

void
PrintTrans(FILE *fp, trans_t *t)
{
	PrintToFd(fp, "trans %s={", SymLookup(t->t_sym));

	if ( t->t_index != (func_t *)NULL )
		PrintToFd(fp, "%s", t->t_index->f_strdef);

	PrintToFd(fp, "}\n");
}

