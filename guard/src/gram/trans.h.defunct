#ifndef _TRANS_H
#define _TRANS_H

#include	"list.h"
#include	"aif.h"
#include	"hash.h"

struct trans_t
{
	hentry_t *			t_sym;
	int					t_debug;
	struct func_t *		t_index;
	int					(*t_builtin)(list_t *);

	/*
	** Fields filled in when translation is being evaluated.
	*/
	int					t_current;
	AIFIndex *			t_ix;
};
typedef struct trans_t	trans_t;

extern void			SetTrans(void);
extern trans_t *	GetTrans(void);
extern trans_t *	FindTrans(char *);
extern int			CheckTrans(hentry_t *);
extern trans_t *	NewTrans(hentry_t *);
extern void			DestroyTrans(trans_t *);
extern AIF *		ApplyTrans(trans_t *, AIF *, AIF *);
extern void			PrintTrans(FILE *, trans_t *);

#endif /* !_TRANS_H */
