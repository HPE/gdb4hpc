# Load the generic configuration for this board. This will define a basic
# set of routines needed by the tool to communicate with the board.
load_generic_config "cray_stubs"

# Load the libraries for this board.
load_lib qsub_stubs.exp

# Set cray specific board information
set_board_info target_init_command "qsub_start \"-l mppwidth=32\""
set_board_info target_exit_command "qsub_exit"
set_board_info guard_var "ccdb"

