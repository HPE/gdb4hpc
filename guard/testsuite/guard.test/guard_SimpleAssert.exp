# NAME: guard_SimpleAssert.exp
# TOOL-LIB: guard.exp
# 
# ABOUT: This is a guard test in order to verify the successful
#        simple graph/assert of a very simple parallel MPI program.
#
# DEPENDENCIES: This test requires the helloworld_mpi program inside of the
#               supplied bin_dir
#
# USER-DEFINES: The width must be set to at least the scalar multiple 2*N
#               were N is the number of cores per compute node. As of 
#               SeaStar/Gemini ALPS requires that only one process can 
#               be allocated per processor.
#
#               The mod_dir should be set to the module directory containing
#               the modules for your specific guard under test.
#
#               The bin_dir should be set to the path to the helloworld_mpi
#               executable.                 
#
# AUTHOR: Andrew Gontarek (andrewg@cray.com)
#

# User Defined Settings
#
set width 8
set bin_name "hello_mpi_c"
set bin_dir "mpi_example"
set src_name "hello_mpi_c.c"
set assert_var "myRank"
set assert_line 19

# Advanced Settings
set timeout 8

# Start up ccdb
guard_start
guard_load

# Test specific proceedures
set test "invoke processes"
# Start the first helloworld_mpi in $p1
send "invoke \$p1 $bin_root/$bin_dir/$bin_name\n"
expect {
        -re "Initial\ breakpoint,\ in .*\(\)\r\n$guard_prompt$" {
                pass "$test: Invoke success on entry."
        }

        eof {
                fail "$test: EOF reached.\n"
        }

        timeout {
                unresolved "$test: timeout.\n"
        }
}

# Start the second helloworld_mpi in $p2
send "invoke \$p2 $bin_root/$bin_dir/$bin_name\n"
expect {
        -re "Initial\ breakpoint,\ in .*\(\)\r\n$guard_prompt$" {
                pass "$test: Invoke success on entry."
        }

        eof {
                fail "$test: EOF reached.\n"
        }

        timeout {
                unresolved "$test: timeout.\n"
        }
}

set test "graph"
# Create a graph named $rank
send "graph \$rank\n"
expect {
	-re "\r\n> $" {
                pass "$test: success on entry."
        }

        eof {
                fail "$test: EOF reached.\n"
        }

        timeout {
                unresolved "$test: timeout.\n"
        }
}

# Create an assertion in $rank to compare the variable "rank" inside of $p1 and $p2
send "assert \$p1::$assert_var@\"$src_name\":$assert_line = \$p2::$assert_var@\"$src_name\":$assert_line\n"
expect {
        -re "\r\n> $" {
                pass "$test: success on assert."
        }

        eof {
                fail "$test: EOF reached.\n"
        }

        timeout {
                unresolved "$test: timeout.\n"
        }
}

# end the graph command block
send "end\n"
expect {
	-re "Graph rank compiled\.\r\n$guard_prompt$" {
                pass "$test: success on end."
        }

        eof {
                fail "$test: EOF reached.\n"
        }

        timeout {
                unresolved "$test: timeout.\n"
        }
}

set test "start"
# start the graph named $rank
send "start \$rank\n"
expect {
        -re "Starting execution of processes\r\nNo difference between $assert_var and $assert_var\r\n" {
                pass "$test: graph success on start."
        }

        eof {
                fail "$test: EOF reached.\n"
        }

        timeout {
                unresolved "$test: timeout.\n"
        }
}

# quit ccdb
guard_quit
guard_exit

