#
# Stub qsub_setup command
#
# PROC_NAME: qsub_setup 
# PARAMS: qsub_opts mod_dir
# RETURNS: NULL
# DESCRIPTION: Use this function to start a new interactive qsub session
#              using the parameters qsub_opts and load module dependencies
#              found inside of mod_dir. Upon return the newest spawn pty
#              will be our interactive qsub session.
# EXAMPLE: qsub_setup {-l mppwidth=8} {/path/to/my/moddir}
#
proc qsub_start {qsub_opts} {
        global spawn_id
        
        # Note that below we wish to run with nocommands tag to prevent bad user input
        eval spawn [subst -nocommands {qsub -I $qsub_opts}]
        expect {
                # pass if we get the job ready prompt
                -re "qsub: job .*\..* ready\r\n\r\n$" {
                        verbose "qsub initialized."
                }
                default {
                        perror "qsub failed."
			return -1
                }
        }
}

# stub qsub_exit command
#
# PROC_NAME: qsub_exit
# PARAMS: NONE
# RETURNS: NULL
# DESCRIPTION: Use this function to send the exit command to our interactive
#              qsub session. Note that we expect to hit a EOF after issuing
#              the exit command.
# EXAMPLE: qsub_exit
#
proc qsub_exit {} {

        send "exit\n"
        expect {
                # pass if we get a job complete message followed by eof
                eof {
                	verbose "qsub exited."
		}

                timeout {
                        warning "Timeout on qsub exit.\n"
                }
        }
        return
}


