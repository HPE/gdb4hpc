#!/usr/bin/env python

import sys, os, distutils.dir_util, distutils.file_util, tarfile, fnmatch
from optparse import OptionParser
from datetime import datetime,date

#gdb4hpc specific modules
import definitions
import gdb4hpc_spec
import gdb4hpc_module


#retrieve some package details
package_info                  = definitions.fetch_newData()
primary_version               = definitions.three_digit_version
build_version_two_digit       = definitions.two_digit_version
build_version_two_digit_nodot = definitions.ver_two_dig_nodot
release_date                  = definitions.release_date 
script_dir                    = os.getcwd()
build_version                 = definitions.version
rpm_name                      = definitions.rpm_name
os_ver                        = definitions.osver
prefix                        = definitions.prefix
prefix_cmd                    = definitions.prefix_cmd
os_name                       = definitions.os_name
arch                          = definitions.arch
arSles15_WB                   = "sles15"
arSles15_HW                   = "7.0"
arSYSTEM_TYPE                 = ['HARDWARE','WHITEBOX','AARCH64']
parent_dir                    = definitions.parent_dir
cti_version                   = definitions.cti_version
cti_lowerBound                = definitions.cti_lowerBound
cti_upperBound                = definitions.cti_upperBound
build_metadata                = definitions.build_metadata

#define some paths
top_dir             = os.getcwd()
work_dir            = top_dir + "/tmp"
rpm_build_dir       = work_dir + "/package"
rpm_install_dir     = rpm_build_dir + "/gdb4hpc-" + build_version
rpm_module_dir      = rpm_install_dir + "/modulefiles"
rpm_gdb4hpc_dir     = rpm_install_dir + "/gdb4hpc"
parent_dir          = top_dir.rsplit('/',1)[0]
man_dir             = parent_dir + "/man"
set_default_gdb4hpc = top_dir + "/set_default/set_default_template"
gdb4hpc_build_dir   = parent_dir + "/gdb4hpc_install"

for directory in ["/bin","/demos","/docs","/lib","/libexec","/modulefiles"]:
  t_dir = gdb4hpc_build_dir + directory
  if not os.path.exists(t_dir):
    print "the build dir you specified is missing: " + t_dir 
    print "Exiting!"
    exit(1)

print "Packaging: " + rpm_name

#spec file
spec_file = "gdb4hpc.spec"

#modulefile
module_dest = rpm_module_dir + "/" + build_version

#set_default script
set_default_script_dest = rpm_install_dir + "/set_default_gdb4hpc_" + build_version

#the source tarball
folder_name = "gdb4hpc-" + build_version
tar_name = folder_name + ".tar.gz"
tar_dest = rpm_build_dir + "/rpm/SOURCES"

#begin the work

#destroy the previous working directory 
if os.path.exists(work_dir):
  distutils.dir_util.remove_tree(work_dir)

#create the rpm_build_dir and child directories
for directory in [work_dir, rpm_build_dir, rpm_install_dir, rpm_module_dir, rpm_gdb4hpc_dir]:
  print "making directory" + directory
  os.mkdir(directory)

#generate the modulefile
module_content = gdb4hpc_module.content.replace('<version>', build_version)

new_mod = open(module_dest, 'w+')
new_mod.write(module_content)
new_mod.close()


#generate the spec file
spec_dest = "gdb4hpc.spec"
spec_content = gdb4hpc_spec.content.replace( "[namespace]", "gdb4hpc")
spec_content = spec_content.replace( "[package_branch_two_digit]", build_version_two_digit)
spec_content = spec_content.replace( "[package_branch_two_digit_nodot]", build_version_two_digit_nodot)
spec_content = spec_content.replace( "[version]", build_version)
spec_content = spec_content.replace( "[build_metadata]", build_metadata)
spec_content = spec_content.replace( "[sles_sub]", "." + os_ver)
spec_content = spec_content.replace( "[ARCH]", arch)
spec_content = spec_content.replace("[tarball]",tar_name)
spec_content = spec_content.replace("[script_dir]", script_dir)
spec_content = spec_content.replace("[cti_lowerBound]", cti_lowerBound)
spec_content = spec_content.replace("[cti_upperBound]", cti_upperBound)
spec_file = open(spec_dest, 'w+')
spec_file.write(spec_content)
spec_file.close()



#copy bin/ lib/ etc dirs from the build dir to rpm_install_dir+/gdb4hpc/lib (etc)
#source: gdb4hpc_build_dir  | contents bin/ demos/ docs/ lib/ modulefiles/
for dir in ['/bin','/demos','/docs','/lib','/modulefiles','/libexec']:
  distutils.dir_util.copy_tree(gdb4hpc_build_dir+dir, rpm_gdb4hpc_dir+dir)


#take care of the set_default sciript
fin = open(set_default_gdb4hpc,'r')
set_def_content = fin.read()
set_def_content = set_def_content.replace('[version_string]', build_version)
set_def_content = set_def_content.replace('[product_name]', "gdb4hpc")
set_def_content = set_def_content.replace('[module_dir]', "[install_dir]/modulefiles")
set_def_content = set_def_content.replace('[module_name_list]', "\"gdb4hpc\"")
new_set_def = open(set_default_script_dest, "w+")
new_set_def.write(set_def_content)
new_set_def.close()

cur_dir = os.getcwd()

#release notes - are in parent directory
os.chdir(rpm_gdb4hpc_dir)

with open("out.txt", "w+") as out:
  for line in open(parent_dir + "/release_info"):
    a = line.replace("%VERSION%", build_version)
    b = a.replace("%BUILD_METADATA%", build_metadata)
    c = b.replace("%RELEASEDATE%", release_date)
    d = c.replace("%os%", os_ver)
    e = d.replace("%os_name%", os_name)
    f = e.replace("%OSPREFIX%", prefix)
    g = f.replace("%PREFIX%", prefix_cmd)
    h = g.replace("%ARCH%", arch)
    out.write(h)

outpath = rpm_gdb4hpc_dir + "/release_info"
distutils.file_util.move_file("out.txt",outpath)


os.chdir(cur_dir)

#setup the RPM directories
for path in ['/rpm/SOURCES','/rpm/BUILD','/rpm/RPMS/' + arch + '/']:
  distutils.dir_util.mkpath(rpm_build_dir+path)

distutils.dir_util.copy_tree(man_dir, rpm_gdb4hpc_dir+"/man")
fileList = os.listdir(rpm_gdb4hpc_dir+"/man/man1/")
for f in fileList:
  extension = os.path.splitext(f)[1]
  if extension == ".txt":
    os.remove(os.path.join(rpm_gdb4hpc_dir+'/man/man1/', f))
  elif extension == ".xml":
    os.remove(os.path.join(rpm_gdb4hpc_dir+'/man/man1/', f))


for dirpath, dirnames, filenames in os.walk(rpm_gdb4hpc_dir):
     for filename in filenames:
       if fnmatch.fnmatch(filename,'.git*'):
	   print "Removing. . . " + dirpath + "/" + filename
	   os.remove(os.path.join(dirpath, filename))
     for dirname in dirnames:
	 if fnmatch.fnmatch(dirname,'.git*'):
	     print "Removing. . . " + dirpath + "/" + dirname
	     distutils.dir_util.remove_tree(dirpath + "/" + dirname)



#tar up the package source 
cur_dir = os.getcwd()
os.chdir(rpm_build_dir)
tar = tarfile.open(tar_name, "w:gz")
tar.add(folder_name)
tar.close()
distutils.file_util.copy_file(tar_name,tar_dest)
os.chdir(cur_dir)
 
#build the rpm
rpmbuild_dest = rpm_build_dir + "/rpm"
print rpmbuild_dest
os.chdir(rpmbuild_dest)
buildcall = "rpmbuild -bb --define \"_tmppath %s\" --define \"_topdir `pwd`\" %s/%s" % (rpm_build_dir,cur_dir,spec_dest)
print buildcall
os.system(buildcall)

#now lets put together the install manifest
os.chdir(rpm_build_dir+"/rpm/RPMS/" + arch + "/")
yaml_template='''---
#----------------------------------------------------------------------------
# IMPORTANT: do not rename sections! The installer uses section names
# to detect changes made to sections, using the MD5 algorithm.
#----------------------------------------------------------------------------
section-1:
    ACCELERATOR           : NONE
    EFFECTIVE_DATE        : NONE
    EMAILS                : kglaser@cray.com
    EMAIL_BUILDER         : NO
    HOSTS                 : ALL 
    INSTALL_DEFAULT_HOSTS : NONE
    NETWORK_TYPE:
        ALL_EXCEPT:
            - SEASTAR
    OPERATION             : INSTALL
    OS_VERSION            : [OS_HW]
    RPM_LIST              : NONE
    SYSTEM_TYPE           : [SYSTEM_TYPE_HW]

section-2:
    ACCELERATOR           : NONE
    EFFECTIVE_DATE        : NONE
    EMAILS                : kglaser@cray.com
    EMAIL_BUILDER         : NO
    HOSTS:
        ALL_EXCEPT:
            - chpbld01
            - chpbld02
    INSTALL_DEFAULT_HOSTS : NONE
    NETWORK_TYPE          : NONE
    OPERATION             : INSTALL
    OS_VERSION            : [OS_WB]
    RPM_LIST              : NONE
    SYSTEM_TYPE           : [SYSTEM_TYPE_WB]

section-3:
    ACCELERATOR           : NONE
    EFFECTIVE_DATE        : NONE
    EMAILS                : kglaser@cray.com
    EMAIL_BUILDER         : NO
    HOSTS                 : ALL
    INSTALL_DEFAULT_HOSTS : NONE
    NETWORK_TYPE:
        ALL_EXCEPT:
            - SEASTAR
    OPERATION             : UPDATE
    OS_VERSION            : [OS_HW]
    RPM_LIST              : NONE
    SYSTEM_TYPE           : [SYSTEM_TYPE_HW]
    COMMANDS: |
            <osprefix>/admin-pe/set_default_files/set_default_gdb4hpc_<version>

section-4:
    ACCELERATOR           : NONE
    EFFECTIVE_DATE        : NONE
    EMAILS                : kglaser@cray.com
    EMAIL_BUILDER         : NO
    HOSTS:
        ALL_EXCEPT:
            - chpbld01
            - chpbld02
    INSTALL_DEFAULT_HOSTS : NONE
    NETWORK_TYPE          : NONE
    OPERATION             : UPDATE
    OS_VERSION            : [OS_WB]
    RPM_LIST              : NONE
    SYSTEM_TYPE           : [SYSTEM_TYPE_WB]
    COMMANDS: |
            <osprefix>/admin-pe/set_default_files/set_default_gdb4hpc_<version>

section-5:
    ACCELERATOR           : NONE
    EFFECTIVE_DATE        : [REMOVAL_DATE]
    EMAILS                : kdavis@cray.com
    EMAIL_BUILDER         : NO
    HOSTS                 : ALL
    INSTALL_DEFAULT_HOSTS : NONE
    NETWORK_TYPE          : NONE
    OPERATION             : REMOVE
    OS_VERSION            : [OS_HW],[OS_WB]
    RPM_LIST              : NONE
    SYSTEM_TYPE           : [SYSTEM_TYPE_REMOVE]
    COMMANDS: |
        rpm -e gdb4hpc-<version>-<build_metadata>

--- |
#Remove previous versions of this rpm
for package in  $(rpm -qa | grep gdb4hpc-<version>-)
do
  rpm -e $package
done

rpm -hiv --oldpackage gdb4hpc-<version>-<build_metadata>.<arch>.rpm

'''
#determine what to use for [OS_WB], [OS_HW], [SYSTEM_TYPE]
os_list_hw=""
os_list_wb=""
system_type_hw=""
system_type_wb=""
system_type_remove=""

if os_ver == "sles15":
  os_list_hw=arSles15_HW
  os_list_wb=arSles15_WB
  system_type_hw=arSYSTEM_TYPE[0]
  system_type_wb=arSYSTEM_TYPE[1]
  system_type_remove=system_type_hw + "," + system_type_wb

print "os_list_hw: " + os_list_hw
print "os_list_wb: " +  os_list_wb
print "system_type_hw: " + system_type_hw
print "system_type_wb:" + system_type_wb
print "system_type_remove: " + system_type_remove

#add 7 years to current date to get removal date for yaml
current_date=date.today()
removal_date=date(current_date.year +7,current_date.month, current_date.day)
removal_date=str(removal_date)
print "removal date: " + str(removal_date)

manifest_dest = rpm_name + ".yaml"
manifest_content = yaml_template.replace("<version>", build_version)
manifest_content = manifest_content.replace("<osprefix>", prefix)
manifest_content = manifest_content.replace("<arch>", arch)
manifest_content = manifest_content.replace("[OS_HW]", os_list_hw)
manifest_content = manifest_content.replace("[OS_WB]", os_list_wb)
manifest_content = manifest_content.replace("[SYSTEM_TYPE_WB]", system_type_wb)
manifest_content = manifest_content.replace("[SYSTEM_TYPE_HW]", system_type_hw)
manifest_content = manifest_content.replace("[SYSTEM_TYPE_REMOVE]", system_type_remove)
manifest_content = manifest_content.replace("<build_metadata>", build_metadata)
manifest_content = manifest_content.replace("[REMOVAL_DATE]", removal_date)
manifest_yaml = open(manifest_dest, "w+")
manifest_yaml.write(manifest_content)
manifest_yaml.close()


