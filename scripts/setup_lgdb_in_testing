#!/bin/bash

top_dir=../
script_dir=$PWD
test_dir=$top_dir/lgdb_in_testing
test_pkg=$script_dir/tmp/package/rpm/RPMS/x86_64/cray-lgdb*rpm
#test_pkg=/cray/css/pe/pkgs/cray-lgdb/2.3/cray-lgdb-2.3.2.1*rpm

#recreate the test dir if present
if [ -d $test_dir ]
  then
    echo "test dir exists, destroy it now..."
    rm -rf $test_dir
    echo "previous test dir destroyed!"
fi

echo "make a new test dir"
mkdir $test_dir
echo "success!"

echo "now jump into the test dir: $test_dir"
pushd $test_dir
  echo "initialize the rpm db"
  rpm --initdb --dbpath $PWD
  cp /var/lib/rpm/* .
  
  echo "lets see if a package exists in the scripts tmp/ dir...."
  if [[ ! -z `ls $test_pkg` ]]
    then
      echo "a package exists!, lets install that ..... sucka!"
      cp $test_pkg .
      rpm -ivh --dbpath $PWD --prefix $PWD --oldpackage cray-lgdb-*x86_64.rpm
     else
     echo "shart, you need to spin a package."
  fi
popd


