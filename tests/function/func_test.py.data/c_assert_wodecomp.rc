# This source file tests the following:
# 1.  Assertion without decomposistion
# 2.  defset command
# 3.  Work with defset, print var, compare newset



#for assertion (dataflow) commands, turn dfblock on
maint set sync on
set dfblock on

# launch 3 instances of the application
launch $a{3} --launcher-args="--exclusive"  bd_dt/c/c_type_test.x --debug

break c_type_test.c:223

launch $b{3} --launcher-args="--exclusive"  bd_dt/c/c_cmp_diff.x --debug

# Set a breakpoint at specified line numbers:
focus $b


break c_cmp_diff.c:223


focus $all


build $mine
	#use assertion without decomposition
	assert $a{0}::assertTest@"c_type_test.c":160=$b{0}::assertTest@"c_cmp_diff.c":160
	assert $a{1}::assertTest@"c_type_test.c":160=$b{1}::assertTest@"c_cmp_diff.c":160
end


#start assertion script
start $mine

#Display active assertion script status.
info script


#Display built assertion scripts.
info build $mine

#exit lgdb
q




