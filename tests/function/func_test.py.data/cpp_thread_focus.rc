maint set sync on

set non-stop on

launch $a{3} bd_dt/C++/cpp_parallel_threads.x --debug

# go until after the threads have started
b 83

c

info threads

defset $workers $a{*:2..11}
viewset

focus $workers

b 67

info breakpoints

c -a

bt 1

frame

n 10

p i

s
s

frame

info threads

bt 3

up 2

p i

info locals

down 2

finish

frame

b addOne

c

up

frame

up
frame

down 2

focus $a{0:2..5}

c

p x

whatis x
assign x 8.0
p x

focus $all
dis 3

c -a

quit




