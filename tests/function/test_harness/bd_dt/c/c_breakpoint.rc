maint set sync on


# launch 3 instances of the application
launch $a{6} --launcher-args="-N1"  bd_dt/c/c_type_test.x --debug


# Set a breakpoint at specified line numbers:
break c_type_test.c:193

break c_type_test.c:223


# Run to breakpoint 1:  
continue

#list breakpoints
info breakpoint

# Test disable command
disable 2

#test has breakpoint 3 been disabled?
info breakpoint

# Test enable command
enable 2  

#has breakpoint 3 been enabled?
info breakpoint

# Test delete command.  This will delete a specified breakpoint in the breakpoint list
delete 2 

#has breakpoint 3 been deleted?
info breakpoint


#exit lgdb
q





