	#get into that directory
	nm=`echo $p | sed 's#\./##g'`

	freq=`echo $nm | tr -dc '/' | wc -c`

	cd $nm

	#get a list of executable files	
	#exec=`find . -type f -executable`

	echo "Cleaning . . ."
	echo `pwd`

	#get list of all files
	other=`find . -type f`
	

	#if there are files in the subdirectory
	while IFS=$'\n' read -ra newADDR; do

		#for each file in the subdirectory
	    for x in "${newADDR[@]}"; do
	
			#delete it if its extension is as below
			
			if [[ $x == *.cub || $x == *.ptx  || $x == *.o*  || $x == *core*  || $x == *.rep*  || $x == *.out  || $x = *.x ]]
			then	
			   
			    rx=`echo $x | sed 's#\./##g'`
			    var=`rm $rx`
			    if [ "$?" -eq "0" ]
			    then
					echo "$rx" deleted
					othcount=$((othcount+1))
			    else
					echo An error occurred: "$x" was not deleted.
			    fi
		      fi
	     done


	done<<<"$other"

	#if two // in path, make sure go back cd ../..
	#else go back cd ..
	if [[ $freq == 1 ]]
	then
		cd ../..
	else
		cd ..
	fi
	echo
	echo
done


#now remove all none essential files in the current directory
cFiles=`find . -type f`
echo `pwd`

