while IFS=$'\n' read -ra curFILES; do

    #for each file in the subdirectory
    for p in "${curFILES[@]}"; do

		#delete it if its extension is as below
		if [[ $p == *.cub || $p == *.ptx  || $p == *.o*  || $p == *core*  || $p == *.log || $p == *.rep* ]]
		then	
			rx=""
		    rx=`echo $p | sed 's#\./##g'`
