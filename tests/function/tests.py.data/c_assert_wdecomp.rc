#maint set sync on

# This source file tests lgdb's decomposition and assertion command
#when using assertion (dataflow) commands, turn on dfblock
set dfblock on

# launch 2 instances of the application
launch $a{3} --launcher-args="%%launcher_args%%"  bd_dt/c/c_type_test.x --debug


launch $b{3} --launcher-args="%%launcher_args%%"  bd_dt/c/c_cmp_diff.x --debug


#Test usage command
usage assert

# create decomposition scheme
decomposition $myComp
dimension 3
distribute block
proc_grid 3
dim_order 1
end


build $mine
	#use assertion with decomposition
	assert $myComp{$a::assertTest@"c_type_test.c":160}=$myComp{$b::assertTest@"c_cmp_diff.c":160}
end


#start assertion script
start $mine

maint sleep 10


#Display active assertion script status.
info script

#Display currently defined decomposition schemes.
info decomposition


#Display built assertion scripts.
info build $mine


#exit lgdb
q

