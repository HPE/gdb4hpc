maint set sync on


# launch 3 instances of the application
launch $a{3} --launcher-args="%%launcher_args%%" bd_dt/c/c_type_test.x --debug

launch $b{3} --launcher-args="%%launcher_args%%" bd_dt/c/c_type_test.x --debug


# Set a breakpoint at specified line numbers:
break c_type_test.c:193


# Run to breakpoint 1:  
continue

p si


#test assign command (changes only procset b)
assign $b::si -12

#print si
p si

#Test assign command (changes both procsets)
assign si -13

p si 


#exit lgdb
q





