maint set sync on


# launch 3 instances of the application
launch $a{6} --launcher-args="%%launcher_args%%"  bd_dt/c/c_dlopen.x --debug


# Set a pending breakpoint at function that will be dlopened
set break pending on
break dlopened_function

# Run to breakpoint 1:  
continue

# backtrace
bt

#list breakpoints
info breakpoint

# Test disable command
disable 2

#test has breakpoint 3 been disabled?
info breakpoint

# Test enable command
enable 2  

#has breakpoint 3 been enabled?
info breakpoint

# Test delete command.  This will delete a specified breakpoint in the breakpoint list
delete 2 

#has breakpoint 3 been deleted?
info breakpoint


#exit lgdb
q
