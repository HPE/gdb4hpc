# This source file tests the following:
# 1.  Assertion without decomposistion
# 2.  defset command
# 3.  Work with defset, print var, compare newset


maint set sync on

# launch 3 instances of the application
launch $a{3} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/c/c_type_test.x --debug


break c_type_test.c:227


launch $b{3} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/c/c_cmp_diff.x --debug


# Set a breakpoint at specified line numbers:
focus $b



break c_cmp_diff.c:227

focus $all


continue


# Test defset command
defset $new_set $b{0..2}

compare $new_set{1}::si=$b{1}::si


#exit lgdb
q





