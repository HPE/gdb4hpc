maint set sync on

# launch 3 instances of the application
launch $a{6} --launcher-args="%%launcher_args%%"  bd_dt/c/c_type_test.x --debug

break c_type_test.c:227

#Display the status of the debug servers.
info status


#List local variables of ranks in current process set.
info scope test_stack

#List variables local to a scope in the application.
info locals


#Show attached/launched applications under debugger control.
info application

#exit lgdb
q






