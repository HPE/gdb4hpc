maint set sync on

# launch 3 instances of the application
launch $a{6} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/c/c_type_test.x --debug


# Set a breakpoint at specified line numbers:
break c_type_test.c:193

continue


# print some local variables
#should be 28.2
print ld

#should be -11
print si  


#exit lgdb
q





