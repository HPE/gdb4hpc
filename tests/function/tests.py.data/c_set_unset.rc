maint set sync on


launch $a{6} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/c/c_type_test.x --debug

#set env var
set environment CRAY_ENV_TEST "TRUE"

#has set env var worked?
show environment

#test unset environment command
unset environment CRAY_ENV_TEST

#has unset var worked?
show environment


#exit lgdb
q





