maint set sync on

# launch 3 instances of the application
launch $a{6} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/c/c_type_test.x --debug

break c_type_test.c:223


continue


#Show how output of assert is displayed.
show display

#Show the debugger version number.
show version

#Show status of forcing of assertion values.
show force

#Show status of stopping on assertion failure.
show stop


#Show current search path for finding source files.
show directories

#Show warn and error epsilon for floating point comparison.
show error


#exit lgdb
q






