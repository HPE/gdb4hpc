#this test compares variables in two files.
#the tests are exactly the same so results should - 
#comparision is true for all

maint set sync on

launch $a{3} --launcher-args="%%launcher_args%%"  bd_dt/c/c_type_test.x --debug


launch $b{3} --launcher-args="%%launcher_args%%"  bd_dt/c/c_type_test.x --debug


#set breakpoint
break c_type_test.c:242

#run to breakpoint
continue


#run compare commands on all datatypes

#char - Dissabled as lgdb compare command is not working for strings and chars
# compare size of same elements in different proc sets - should be true
#print c
#compare $a{0}::"sizeof(c)" = $b{0}::"sizeof(c)"

#signed char
print sc
compare $a{0}::"sizeof(sc)" = $b{0}::"sizeof(sc)"

#unsigned char
print uc
compare $a{0}::"sizeof(uc)" = $b{0}::"sizeof(uc)"

#short
print sh
compare $a{0}::"sizeof(sh)" = $b{0}::"sizeof(sh)"

#short int
print shi
compare $a{0}::"sizeof(shi)" = $b{0}::"sizeof(shi)"

#signed short
print ssh
compare $a{0}::"sizeof(ssh)" = $b{0}::"sizeof(ssh)"

#signed short int
print sshi
compare $a{0}::"sizeof(sshi)" = $b{0}::"sizeof(sshi)"

#usinged short
print ush
compare $a{0}::"sizeof(ush)" = $b{0}::"sizeof(ush)"

#usigned short int
print ushi
compare $a{0}::"sizeof(ushi)" = $b{0}::"sizeof(ushi)"

#int
print i
compare $a{0}::"sizeof(i)" = $b{0}::"sizeof(i)"

#signed int
print si
compare $a{0}::"sizeof(si)" = $b{0}::"sizeof(si)"

#unsigned
print u
compare $a{0}::"sizeof(u)" = $b{0}::"sizeof(u)"

#unsigned int
print ui
compare $a{0}::"sizeof(ui)" = $b{0}::"sizeof(ui)"

#long
print l
compare $a{0}::"sizeof(l)" = $b{0}::"sizeof(l)"

#long int
print li
compare $a{0}::"sizeof(li)" = $b{0}::"sizeof(li)"

#signed long
print sl
compare $a{0}::"sizeof(sl)" = $b{0}::"sizeof(sl)"

#signed long int
print sli
compare $a{0}::"sizeof(sli)" = $b{0}::"sizeof(sli)"

#unsigned long
print ul
compare $a{0}::"sizeof(ul)" = $b{0}::"sizeof(ul)"

#unsigned long int
print uli
compare $a{0}::"sizeof(uli)" = $b{0}::"sizeof(uli)"

#long long
print ll
compare $a{0}::"sizeof(ll)" = $b{0}::"sizeof(ll)"

#long long int
print lli
compare $a{0}::"sizeof(lli)" = $b{0}::"sizeof(lli)"

#signed long long
print sll
compare $a{0}::"sizeof(sll)" = $b{0}::"sizeof(sll)"

#signed long long int
print slli
compare $a{0}::"sizeof(slli)" = $b{0}::"sizeof(slli)"

#unsigned long long
print ull
compare $a{0}::"sizeof(ull)" = $b{0}::"sizeof(ull)"

#unsigned long long int
print ulli
compare $a{0}::"sizeof(ulli)" = $b{0}::"sizeof(ulli)"

#float
print f
compare $a{0}::"sizeof(f)" = $b{0}::"sizeof(f)"

#double
print d
compare $a{0}::"sizeof(d)" = $b{0}::"sizeof(d)"

#long double
print ld
compare $a{0}::"sizeof(ld)" = $b{0}::"sizeof(ld)"



#continue

q
