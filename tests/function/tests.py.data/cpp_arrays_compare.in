21: # distributedArray1 and distributedVec should each have 40 elements, define
22: # a 1d and 2d decomposition.
24: # 1D Decomp - not strictly necessary or useful as it turns out
25: decomposition $dd
26: dimension 40
27: distribute *
28: proc_grid *
29: dim_order *
30: end
32: # 2D Decomp - note that we are testing decomposition that actually decompose
33: # the date in another test.   The ability to deal with a C/C++ array as 
34: # 2d is darn interesting.
35: decomposition $d2
36: dimension 10,4
37: distribute *,*
38: proc_grid *,*
39: dim_order *,*
40: end
42: # localArray is actually decomposed
43: decomposition $sp
44: dimension 240
45: distribute block
46: proc_grid 3
47: end
