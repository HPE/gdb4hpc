maint set sync on

# launch 3 instances of the application
launch $a{3} --launcher-args="%%launcher_args%%" --args="0 40" bd_dt/C++/cpp_arrays.x
launch $b{3} --launcher-args="%%launcher_args%%" --args="1 40" bd_dt/C++/cpp_arrays.x

# run until the arrays are initialized
b 76
c

# distributedArray1 and distributedVec should each have 40 elements, define
# a 1d and 2d decomposition.

# 1D Decomp - not strictly necessary or useful as it turns out
decomposition $dd
dimension 40
distribute *
proc_grid *
dim_order *
end

# 2D Decomp - note that we are testing decomposition that actually decompose
# the date in another test.   The ability to deal with a C/C++ array as 
# 2d is darn interesting.
decomposition $d2
dimension 10,4
distribute *,*
proc_grid *,*
dim_order *,*
end

# localArray is actually decomposed
decomposition $sp
dimension 240
distribute block
proc_grid 3
end

# at this point in the the comparisons should succeed
compare $a::array2d == $b::array2d
p "distributedArray1[0]@40"
compare $a::"distributedArray1[0]@40" == $b::"distributedArray1[0]@40"

p $d2{$a::"localArray1[0]@40"}
#p $d2{"localArray1[0]@40"}

# all right, this one doesn't work
#p std_array
#compare $a::std_array == $b::std_array

p distributedVec1
p localVec
compare $a::distributedVec1 == $b::distributedVec1
#compare $a::localVec == $b::localVec
#compare $d2{$a::localVec} == $d2{$b::localVec}

compare $sp{$a::localVec} == $sp{$b::localVec}
# this one was done by accident, but it orignally crashed
#compare $sp{$a::localVec} == $sp{b::localVec}
compare $sp{$a::"localArray1[0]@80"} == $sp{$b::"localArray1[0]@80"}

#cross compare - and why not
compare $sp{$a::"localArray1[0]@80"} == $sp{$b::localVec}

compare $a::wafflesArray == $b::wafflesArray
compare $a::"wafflesVec[0]@40" == $b::"wafflesVec[0]@40"

# continue to a point where the same comparisons should fail
b 87
c

compare $a::array2d == $b::array2d
p "distributedArray1[0]@40"
compare $a::"distributedArray1[0]@40" == $b::"distributedArray1[0]@40"

p $d2{$a::"localArray1[0]@40"}
p distributedVec1
p localVec
compare $a::distributedVec1 == $b::distributedVec1

compare $sp{$a::localVec} == $sp{$b::localVec}
# this one was done by accident, but it orignally crashed
#compare $sp{$a::localVec} == $sp{b::localVec}
compare $sp{$a::"localArray1[0]@80"} == $sp{$b::"localArray1[0]@80"}

#cross compare - and why not
compare $sp{$a::"localArray1[0]@80"} == $sp{$b::localVec}

compare $d2{$a::distributedVec1} == $d2{$b::distributedVec1}

compare $a::wafflesArray == $b::wafflesArray
compare $a::"wafflesVec[0]@40" == $b::"wafflesVec[0]@40"

quit

