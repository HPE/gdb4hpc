maint set sync on

# character array specific tests
launch $a{3} --launcher-args="%%launcher_args%%" bd_dt/C++/cpp_arrays_print.x --debug

break cpp_arrays_print.cpp:28

continue

# full char arrays
p one_d
p one_d_u
p one_d_s
p two_d
p two_d_u

# full arrays
print intarray
print intarray2d
print intarray2d2
print floatarray

# single elements
## valid
p one_d[0]
p two_d[0][0]
p two_d[2][0]
p intarray[2]
p intarray2d[1][1]

## out of range
p one_d[256]
p two_d[256][0]
p two_d[0][256]
p intarray[10]

# strings
p cstring
p cptr
p const_cstring
p empty
p cstringarray

# make sure normal pointers still work too
p inte
p intp
p *intp

# make sure printing a char** is normal
p argv

# setting pring elements
set print elements 3

p intarray
p intarray2d
p intarray2d2
p two_d

kill $a

q
