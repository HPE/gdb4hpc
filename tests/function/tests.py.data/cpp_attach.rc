# attach to a process and mess with a variable, breaking out of a loop
maint set sync on

attach $a %%appid%%

break 20

# climp up to main- the depth we will get stopped at can vary, so be excessive...
up
up
up
up
up

# beacon for text matching
maint echo beacon

# change argc, which will break us out of the loop
assign argc 999

# continue to line 20
c

p argc

q
