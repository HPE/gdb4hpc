maint set sync on

# launch 3 instances of one application and 4 of another to test decomp
launch $a{3} --launcher-args="%%launcher_args%%" --args="0" bd_dt/fortran/ftn_decomp.x
launch $b{4} --launcher-args="%%launcher_args%%" --args="1" bd_dt/fortran/ftn_decomp.x

# run until the arrays are initialized
b 109
c

decomposition $block1_3
dimension 120
distribute block
proc_grid 3
end

decomposition $block1_4
dimension 120
distribute block
proc_grid 4
end

decomposition $cyclic1_3
dimension 120
distribute cyclic
proc_grid 3
end

decomposition $cyclic1_4
dimension 120
distribute cyclic
proc_grid 4
end

decomposition $blockCyclic1_3
dimension 120
distribute 5
proc_grid 3
end

decomposition $blockCyclic1_4
dimension 120
distribute 5
proc_grid 4
end

decomposition $block2_3
dimension 10,12
distribute *,block
proc_grid *,3
end

decomposition $block2_4
dimension 10,12
distribute *,block
proc_grid *,4
end

decomposition $cyclic2_3
dimension 10,12
distribute *,cyclic
proc_grid *,3
end

decomposition $cyclic2_4
dimension 10,12
distribute *,cyclic
proc_grid *,4
end

decomposition $blockCyclic2_3
dimension 5 ,24
distribute *, 2
proc_grid * , 3
end

decomposition $blockCyclic2_4
dimension 5,24
distribute *,2
proc_grid *,4
end

decomposition $block3_3
dimension 5,4,12
distribute *,*,block
proc_grid *,*,3
end

decomposition $block3_4
dimension 5,4,12
distribute *,*,block
proc_grid *,*,4
end

# lets just print the cotton pickers out so we have a record of the result
p $block1_3{$a::block1}
p $block1_4{$b::block1}
p $cyclic1_3{$a::cyclic1}
p $cyclic1_4{$b::cyclic1}
p $blockCyclic1_3{$a::blockCyclic1}
p $blockCyclic1_4{$b::blockCyclic1}
p $block2_3{$a::block2}
p $block2_4{$b::block2}
p $cyclic2_3{$a::cyclic2}
p $cyclic2_4{$b::cyclic2}
p $blockCyclic2_3{$a::blockCyclic2}
p $blockCyclic2_4{$b::blockCyclic2}
p $block1_3{$a::offsetBlock1}
p $block1_4{$b::offsetBlock1}
p $cyclic1_3{$a::offsetCyclic1}
p $cyclic1_4{$b::offsetCyclic1}
p $block3_3{$a::block3}
p $block3_4{$b::block3}


# at this point in the the comparisons should succeed

compare $block1_3{$a::block1} == $block1_4{$b::block1}
compare $cyclic1_3{$a::cyclic1} == $cyclic1_4{$b::cyclic1}
compare $blockCyclic1_3{$a::blockCyclic1} == $blockCyclic1_4{$b::blockCyclic1}
compare $block2_3{$a::block2} == $block2_4{$b::block2}
compare $cyclic2_3{$a::cyclic2} == $cyclic2_4{$b::cyclic2}
compare $blockCyclic2_3{$a::blockCyclic2} == $blockCyclic2_4{$b::blockCyclic2}
compare $block1_3{$a::offsetBlock1} == $block1_4{$b::offsetBlock1}
compare $cyclic1_3{$a::offsetCyclic1} == $cyclic1_4{$b::offsetCyclic1}
compare $block3_3{$a::block3} == $block3_4{$b::block3}

# continue to a point where the same comparisons should fail
b 124
c

compare $block1_3{$a::block1} == $block1_4{$b::block1}
compare $cyclic1_3{$a::cyclic1} == $cyclic1_4{$b::cyclic1}
compare $blockCyclic1_3{$a::blockCyclic1} == $blockCyclic1_4{$b::blockCyclic2}
compare $block2_3{$a::block2} == $block2_4{$b::block2}
compare $cyclic2_3{$a::cyclic2} == $cyclic2_4{$b::cyclic2}
compare $blockCyclic2_3{$a::blockCyclic2} == $blockCyclic2_4{$b::blockCyclic2}
compare $block1_3{$a::offsetBlock1} == $block1_4{$b::offsetBlock1}
compare $cyclic1_3{$a::offsetCyclic1} == $cyclic1_4{$b::offsetCyclic1}
compare $block3_3{$a::block3} == $block3_4{$b::block3}

quit

