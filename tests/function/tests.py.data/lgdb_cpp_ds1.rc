# This source files tests most of lgdb's basic commands for C++ source code

maint set sync on


# launch 3 instances of the application
#launch $a{3} --launcher-args="%%launcher_args%%"  bd_dt/C++/cpp_ds_test1.x --debug

launch $b{3} --launcher-args="%%launcher_args%%"  bd_dt/C++/cpp_ds_test1.x --debug


# Set a breakpoint at specified line numbers:
break cpp_ds_test1.cpp:97
break cpp_ds_test1.cpp:105

# Run to breakpoint 2:
continue

p s
p c

# Run to breakpoint 1
continue



# print some local variables
print i

print l_tail

print pq_tail

print stack_top

print q_queue_tail

print d_queue_tail

print vec_float

print vec_double

# run compare command
compare $b{0}::area1=$b{1}::area1

compare $b{0}::area2=$b{1}::area2

# print the containers to verify the pretty printing
print l
print pq
print s
print q
print d
print vf
print vd

p s1
p c1

p ll
p *ll

continue


#quit lgdb
q
