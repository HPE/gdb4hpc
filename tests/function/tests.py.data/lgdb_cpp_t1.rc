# This source files tests most of lgdb's basic commands for C++ source code

maint set sync on


# launch 3 instances of the application
launch $a{3} --launcher-args="%%launcher_args%%"  bd_dt/C++/cpp_bd_test.x --debug

launch $b{3} --launcher-args="%%launcher_args%%"  bd_dt/C++/cpp_bd_test.x --debug


#ensure current location is at line #116
l



# Set a breakpoint at specified line numbers:
break cpp_bd_test.cpp:134

break cpp_bd_test.cpp:136


# Run to breakpoint 1:
continue


# Confirm program is at specified line:
#list


# print some local variables
print x

print ret


# run compare command
compare $b{0}::ret=$a{0}::ret

# compare size of same elements in different proc sets
compare $a{0}::"sizeof(ret)" = $b{0}::"sizeof(ret)"


#continue to second breakpoint
continue

print y

#confirm program is at specified line
#list

#continue


#quit lgdb
q




