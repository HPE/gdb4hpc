maint set sync on


# launch 2 applications in lgdb
launch $a{3} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/fortran/ftn_bd_dt.x --debug


launch $b{3} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/fortran/ftn_bd_dt.x --debug



# Set a breakpoint at specified line numbers:
break ftn_bd_dt.f90:46

break ftn_bd_dt.f90:62



# Run to breakpoint 1:
continue


# Confirm program is at specified line: 46
#list


# print some local variables
print x

print tf


# run compare command
compare $a{0}::tf=$b{0}::tf

# compare size of same elements in different proc sets
compare $a{0}::"sizeof(tf)" = $b{0}::"sizeof(tf)"


# Continue to the second breakpoint 
continue


# Ensure program is set at breakpoint line # 62
#l

# Print m
p m


#Exit lgdb
q



