# This source file tests lgdb's  compare command for source code in fortran.
# All results should be PASS.


maint set sync on

# launch 2 applications in lgdb
launch $a{3} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/fortran/ftn_bd_dt.x --debug

launch $b{3} --launcher-args="--exclusive %%launcher_args%%"  bd_dt/fortran/ftn_bd_dt.x --debug


# Set a breakpoint at specified line number:
break ftn_bd_dt.f90:64



# Run to breakpoint 1:
continue


# run compare commands on all datatypes
print tf

#logical
compare $a{0}::tf=$b{0}::tf


print x

#integer
compare $a{0}::x=$b{0}::x

print l

#character
compare $a{0}::l=$b{0}::l

print e

#real
compare $a{0}::e=$b{0}::e

print word

#character*7
compare $a{0}::word=$b{0}::word

print r

#complex
compare $a{0}::r=$b{0}::r

print df

#real*8 -> double float
compare $a{0}::df=$b{0}::df

print m

#character array
compare $a{0}::m=$b{0}::m

print myself.name

#struct object data member of type character*4
compare $a{0}::myself.name=$b{0}::myself.name


#Exit lgdb
q



