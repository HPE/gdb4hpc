15: # This source file tests lgdb's  compare command for source code in fortran.
16: # All results should be FAILURE.
17: maint set sync on
18: # launch 2 applications in lgdb
19: launch $a{3}  bd_dt/fortran/ftn_bd_dt.x --debug
