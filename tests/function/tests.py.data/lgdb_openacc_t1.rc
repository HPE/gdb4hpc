# launch 3 instances of the application
launch $a{6} --launcher-args="-N1 %%launcher_args%%"  open_acc/open_acc1.x --gpu --debug


break open_acc_test.f90:58

break open_acc_test.f90:28


#continue to 1st breakpoint
