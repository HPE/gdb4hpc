1: -gdb-set print elements error_messages_are_logged_and_attached_to_^error
&"Error: couldn't convert \"error_messages_are_logged_and_attached_to_^error\" to an integer. (stoi)\n"
^error,msg="Error: couldn't convert \"error_messages_are_logged_and_attached_to_^error\" to an integer. (stoi)"
(gdb)
&"Command resulted in an error: 1: -gdb-set print elements error_messages_are_logged_and_attached_to_^error\n"
2: # multi line error messages are logged, but only the first line is attached to ^error
^done
(gdb)
3: -exec-arguments $a{1} ./bin/CRAY/c/c_not_mpi.x
^done
(gdb)
4: -file-exec-and-symbols
&"Debugger error: Missing PMI or MPI entrypoint symbol!\n"
&"Application is missing required function for startup.\n"
&"\n"
&"This is usually MPI_Init()/shmem_init()/etc. To bypass this check,\n"
&"add the --non-mpi argument to launch, or\n"
&"use the command \"maint set unsafe on\". Note that your application\n"
&"may hang during startup.\n"
^error,msg="Debugger error: Missing PMI or MPI entrypoint symbol!"
(gdb)
&"Command resulted in an error: 4: -file-exec-and-symbols\n"
5: # same when using the console fallback
^done
(gdb)
6: launch $a{1} ./bin/CRAY/c/c_not_mpi.x
