17: # distributedArray1 and distributedVec should each have 40 elements, define
18: # a 1d and 2d decomposition.
19: # 1D Decomp - not strictly necessary or useful as it turns out
20: decomposition $dd
21: dimension 40
22: distribute *
23: proc_grid *
24: dim_order *
25: end
26: # 2D Decomp - note that we are testing decomposition that actually decompose
27: # the date in another test.   The ability to deal with a C/C++ array as 
28: # 2d is darn interesting.
29: decomposition $d2
30: dimension 10,4
31: distribute *,*
32: proc_grid *,*
33: dim_order *,*
34: end
35: # localArray is actually decomposed
36: decomposition $sp
37: dimension 240
38: distribute block
39: proc_grid 3
40: end
41: # wafflesArray has 40 elements
42: decomposition $d0
43: dimension 120
44: distribute block
45: proc_grid 3
46: end
