#!/bin/bash

	#add test to test SIG on instance of lgdb
	#create array of SIG commands
	#15=SIGTERM, 2=SIGINT, 3=SIGQUIT, 9=SIGKILL, 1=SIGHUP
    tlog=$1
	sig_count=0
	SIGNALS[0]=SIGTERM
	SIGNALS[1]=SIGQUIT
	SIGNALS[2]=SIGKILL
	SIGNALS[3]=SIGHUP

	#-15 and -1 should return 0, terminate lgdb, and will exit the script
	#to avoid script exit, must launch lgdb in its own process group.
	#if its not in its own process group, when it is killed, it will
	#kill all processes in the same process group.
	echo "SIGNAL TESTING..." 2>&1 | tee -a $tlog
	echo 2>&1 | tee -a $tlog
	#set -x
	echo parent: $$ 2>&1 | tee -a $tlog

	for sig in "${SIGNALS[@]}"; do

		#launch lgdb in background, ensure launching 2 applications and send to outputfile
		bash -i -c "gdb4hpc" &

		#get pid from background process
		pid=$!

		#echo "killing child pid: $pid"
		kill ${sig} $pid 2> /dev/null

		sleep 1
		#has it been killed?
		kill -0 $pid 2> /dev/null
		if [[ $? == 1 ]]
		then
			echo "  This GDB4HPC instance (pid: $pid) was successfully killed by ${SIGNALS[${sig_count}]}." 2>&1 | tee -a $tlog

			#Put into PASSED ARRAY
			passed[h]="$sig-0"
			h=$((h+1))
		else
			echo "  This GDB4HPC instance (pid: $pid) was not successfully killed by ${SIGNALS[${sig_count}]}." 2>&1 | tee -a $tlog
			ps -u $user 2>&1 | tee -a $tlog

			#Put into FAILED ARRAY
			failures[g]="$sig-0"
			g=$((g + 1))
	    fi
	    sig_count=$((sig_count + 1))
    	    echo 2>&1 | tee -a $tlog

        done

	my_count=0
	for fls in "${passed[@]}"; do
	    
	    if [[ $my_count -eq 0 ]]
	    then
		echo "*** PASSED ***" 2>&1 | tee -a $tlog
		my_count=$((my_count + 1))
	    fi
	    echo $fls 2>&1 | tee -a $tlog
	done

	my_count=0
	for fls in "${failures[@]}"; do

	    if [[ $my_count -eq 0 ]]
	    then
		echo"*** FAILED ***" 2>&1 | tee -a $tlog
		my_count=$((my_count + 1))
	    fi
	    echo $fls 2>&1 | tee -a $tlog
	done
