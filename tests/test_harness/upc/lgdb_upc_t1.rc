maint set sync on

# launch 2 applications in lgdb
launch $a{6} --launcher-args=""  upc/upc.x --debug


# test list command, ensure your on line 78
l

# Create breakpoints
break upc_test.c:81


# Continue to breakpoint:
continue


# Ensure program is at line 81
l


# Enter gdbmode
gdbmode


# While still in gdbmode, display the language used
show lang




# While still in gdbmode, display address of shared array
p & array[0]




#  Print contents at address of array (use address displayed in last command)
p *(shared struct data_struct*) $1




# Exit gdbmode
end


# Exit debugger
q





