load_lib "offload.exp"

standard_testfile "simple_class.cpp" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} ${srcdir}/${subdir}/${srcfile2}" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile

offload_attach_sequence "myo"

gdb_test "break simple_class.cpp:24" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 24"
gdb_test_no_output "disable" "disable breakpoint 1"

gdb_test "break simple_class.cpp:34" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 34"
gdb_test_no_output "disable" "disable breakpoint 2"

# this is the one we want to hit
gdb_test "break simple_class.cpp:53" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 53"

gdb_test "continue" ".*volatile int checkdummy = 1;.*" "cont"

gdb_exit

offload_cleanup
