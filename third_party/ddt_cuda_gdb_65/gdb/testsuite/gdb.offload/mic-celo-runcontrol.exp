# Test goals: check non-basic run control in celo apps

load_lib "offload.exp"

standard_testfile "msample06.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
        untested "${testfile}.exp"
        return -1
    }

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_test "break ${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"] if (i == 10)" "Breakpoint 2 at .*${srcfile}, line 19." "set conditional BP"
gdb_continue_to_breakpoint "continue to BP1"

gdb_test "p data\[10\]" "\\\$\\d+ = 10.0" "data\[10\] == 10.0"
gdb_test "p data\[11\]" "\\\$\\d+ = 0.0" "data\[11\] == 0.0"

### check 2 - temporary breakpoint
# get out of the in1[] initialization loop
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP2" "${srcfile}"]"
gdb_continue_to_breakpoint "BP2"

# skip the first iteraion of in2[] initialization
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "force reading the current value" "${srcfile}"]"
gdb_continue_to_breakpoint "continue 1"
gdb_continue_to_breakpoint "continue 2"
delete_breakpoints

# now check we can stop at a temp breakpoint
gdb_test "tbreak ${srcfile}:[gdb_get_line_number "i * step" "${srcfile}"]" "Temporary breakpoint 5 at .*${srcfile}, line 18." "set first temporary BP"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP2" "${srcfile}"]"
gdb_test "info break" ".*5\\s+breakpoint\\s+del\\s+y.*${srcfile}:18\[\r\n\]
6\\s+breakpoint\\s+keep\\s+y.*${srcfile}:21" "1st check break info"

gdb_continue_to_breakpoint "continue 3"
gdb_test "p i" "\\\$\\d+ = 1" "i == 1"
gdb_test "p data\[1\]" "\\\$\\d+ = 0" "data\[1\] == 0"

# now check it's really temporary (i.e. it was removed)
gdb_test "info break" "Num.*What\[\r\n\]
6\\s+breakpoint\\s+keep\\s+y.*${srcfile}:21" "2nd check break info"
gdb_continue_to_breakpoint "continue 4"

gdb_test "p superdummy" "\\\$\\d+ = 8192" "superdummy == 4096*2.0"

### check 3 - temporary breakpoint in a future offload
delete_breakpoints
gdb_test "tbreak ${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"]" "Temporary breakpoint 7 at .*${srcfile}, line 19." "set second temporary BP"
gdb_continue_to_breakpoint "continue 5"

gdb_test "p i" "\\\$\\d+ = 0" "i == 0"
gdb_test "p in2\[4096\]" "\\\$\\d+ = 8192" "in2\[4096\] == 4096*2.0"

gdb_exit
offload_cleanup