# Test goals: evaluation an ownership by shared struct directly and using a shared pointer

load_lib "offload.exp"

standard_testfile "msample09.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"]"
gdb_continue_to_breakpoint "1st continue to BP1"

# we have no ownership here, write won't cause the var to be actually updated
gdb_test_no_output "set sci_ptr->si=0x11223344" "set sci_ptr->si=0x11223344"
gdb_test "p sci_ptr->si" "\\\$\\d+ = 0x11223344" "1st check: sci_ptr->si == 0x11223344"

gdb_continue_to_breakpoint "2nd continue to BP1"

gdb_test "p sci_ptr->si" "\\\$\\d+ = 0x70000000" "sci_ptr->si == 0x70000000"
gdb_test "p SCI.si" "\\\$\\d+ = 0x70000000" "SCI.si == 0x70000000"

# now modify the variable in a region where we have ownership
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP2" "${srcfile}"]"
gdb_continue_to_breakpoint "1st continue to BP2"

gdb_test_no_output "set SCI.si=0x11223344" "set SCI.si=0x11223344"
gdb_test "p SCI.si" "\\\$\\d+ = 0x11223344" "check setting SCI.si == 0x11223344"

delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"]"
gdb_continue_to_breakpoint "3rd continue to BP1"

gdb_test "p sci_ptr->si" "\\\$\\d+ = 0x11223344" "2nd check: sci_ptr->si == 0x11223344"
gdb_test "p SCI.si" "\\\$\\d+ = 0x11223344" "SCI.si == 0x11223344"

gdb_exit
offload_cleanup
