# Test goals: test that modifying a shared var before it's accessed in the debuggee doesn't confuse the
#        myo runtime - we shouldn't have rights to modify the variable at this moment, if we try to
#        the debugger should prevent it

load_lib "offload.exp"

standard_testfile "msample11.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"]"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP6" "${srcfile}"]"

# run to the initial statement of the shared function and try to modify a shared variable which
# hasn't been accessed yet
gdb_continue_to_breakpoint "continue to BP1"

gdb_test_no_output "set global_A=5" "set global_A=5"
gdb_test "p global_A" "\\\$\\d+ = 5" "global_A == 5"

# continue until the last statement of the function and evaluate the var we modified earlier, our
# changes shouldn't have modified anything
gdb_continue_to_breakpoint "continue to BP6"

# check we didn't actually modify its value
gdb_test "p global_A" "\\\$\\d+ = 43" "global_A == 43"

# finish the current offloaded function and come back to it again, then evaluate after a read.
# this way we're sure we actually didn't affect host/target variables syncdelete_breakpoints
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP3" "${srcfile}"]"
gdb_continue_to_breakpoint "continue to BP3"

gdb_test "p global_A" "\\\$\\d+ = 45" "global_A == 45"

gdb_exit
offload_cleanup
