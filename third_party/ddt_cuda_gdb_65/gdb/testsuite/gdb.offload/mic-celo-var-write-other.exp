# Test goals: test that modifying a shared variable before it's accessed doesn't affect other vars in the
#        same memory page (here we're assuming the two integers will be allocated on the same page)

load_lib "offload.exp"

standard_testfile "msample11.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"]"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP6" "${srcfile}"]"

# modify one variable an check we didn't affect the other
gdb_continue_to_breakpoint "continue to BP1"

gdb_test_no_output "set global_A=5" "set global_A=5"
gdb_test "p global_A" "\\\$\\d+ = 5" "global_A == 5"

gdb_continue_to_breakpoint "continue to BP6"
gdb_test "p global_B" "\\\$\\d+ = 8" "global_B == 8"

# finish the current offloaded function and come back to it again, then evaluate the "other"
# variable we modified earlier after a read.
# this way we're sure we actually didn't affect host/target variables sync
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP4" "${srcfile}"]"
gdb_continue_to_breakpoint "continue to BP4"

gdb_test "p global_B" "\\\$\\d+ = 11" "global_B == 11"

gdb_exit
offload_cleanup
