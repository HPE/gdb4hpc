# Test goals: checks that parameters of a function can be evaluated
#             on the target side.
# TODO: add more datatypes.

load_lib "offload.exp"

standard_testfile "msample05.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "int1" "${srcfile}"]"
gdb_continue_to_breakpoint "int1"
gdb_test "print val" "\\\$\\d+ = 42" "print val (int)"
gdb_test "next" ".*local_val\\\+\\\+;" "next 1 (int)";
gdb_test "print local_val" "\\\$\\d+ = 42" "print local_val (int)"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "double1" "${srcfile}"]"
gdb_continue_to_breakpoint "double1"
gdb_test "print val" "\\\$\\d+ = 42.42.*" "print val (double)"
gdb_test "next" ".*local_val\\\+\\\+;" "next 1 (double)";
gdb_test "print local_val" "\\\$\\d+ = 42.42.*" "print local_val (double)"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "float1" "${srcfile}"]"
gdb_continue_to_breakpoint "float1"
gdb_test "print val" "\\\$\\d+ = 42.424242.*" "print val (float)"
gdb_test "next" ".*local_val\\\+\\\+;" "next 1 (float)";
gdb_test "print local_val" "\\\$\\d+ = 42.424242.*" "print local_val (float)"


gdb_exit
offload_cleanup
