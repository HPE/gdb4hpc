# Test goals: Basic myo check.

load_lib "offload.exp"

standard_testfile "msample02.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "write_shared" "${srcfile}"]"
gdb_continue_to_breakpoint "write_shared 1"
gdb_test "print global" "\\\$1 = 1" "global == 1"

gdb_continue_to_breakpoint "write_shared 2"
gdb_test "print global" "\\\$2 = 4" "global == 4"

gdb_continue_to_breakpoint "write_shared 3"
gdb_test_no_output "set global = global+1"
gdb_continue_to_breakpoint "write_shared 4"
gdb_test "print global" "\\\$2 = 11" "global == 11"

gdb_exit
offload_cleanup
