# Test goals: repeatedly attach/deattach to a new offloaded region
#             (but still in the same program).

load_lib "offload.exp"

standard_testfile "msample03.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "loop_breakpoint" "${srcfile}"]"
gdb_continue_to_breakpoint "loop_breakpoint"
gdb_test "print offload_count" "\\\$\\d+ = 1" "offload_count == 1"
gdb_test "print local_count" "\\\$\\d+ = 1" "local_count == 1"

for {set i 0} {$i < 16} {incr i} {
    gdb_test_no_output "set loop=0" "set loop=0 in test loop"

    gdb_test "detach" "Detaching from program:.*offload_main, process \\d+\r\nEnding remote debugging." "detach ${i}"
    set tpid [get_offloadmain_pid]
    if { !$tpid } {
        fail "target process id was not found (${i})"
    }
    set gdbserver_pid [attach_micnativeloadex_gdbserver "${tpid}" "${mic_card_id}"]
    # leave the micnativeloadex tool and gdbserver some time to come up
    sleep 1
    gdb_test "target remote ${mic_card_address}:${gdbserver_port}" ".*Remote debugging using ${mic_card_address}:${gdbserver_port}.*" "remote connect ${i}"
    gdb_continue_to_breakpoint "loop_breakpoint"
    gdb_test "print offload_count" "\\\$\\d+ = [expr {$i+2}]" "offload_count == [expr {$i+1}]"
    gdb_test "print local_count" "\\\$\\d+ = [expr {$i+2}]" "local_count == [expr {$i+1}]"
}

gdb_exit
offload_cleanup
