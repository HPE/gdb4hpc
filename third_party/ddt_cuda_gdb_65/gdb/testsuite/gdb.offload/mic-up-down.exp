# Test goals: test we can walk up and down the stack and print locals without making
#             the debugger crash. In the first part test it in an deterministic fashion 
#             were we can check the output. In the second part test it in a stress testing
#             fashion and check afterwards if GDB is still alive and is able to continue.

load_lib "offload.exp"

standard_testfile "cilk-for-simple.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
send_gdb "set var loop = 1\n"

# 1) test up/down in a deterministic fashion
# ------------------------------------------

# expect bp and loop to be in the locals
gdb_test "info locals" ".*bp = 1\r\nloop = 1.*" "info locals 1"

# go one up and check if we are in an know area of myo_attach_default.c
gdb_test "up" "#\\d+\\s+0x\[0-9a-f\]+\\s+in\\s+myo_attach_gdb_wrapper.*at.*${srcfile2}:1.*" "up 1"
# expect loop to be in the locals
gdb_test "info locals" ".*loop = \\d+.*" "info locals 2"

# go one up, should step into the library
gdb_test "up" "#\\d+\\s+0x\[0-9a-f\]+\\s+in\\s+.*(at|from).*(:\\d+)?.*" "up 2"

# go one down and check if we are in an know area of myo_attach_default.c
gdb_test "down" "#\\d+\\s+0x\[0-9a-f\]+\\s+in\\s+myo_attach_gdb_wrapper.*at.*${srcfile2}:1.*" "up 3"
# expect loop to be in the locals
gdb_test "info locals" ".*loop = \\d+.*" "info locals 3"

gdb_test "down" "#\\d+\\s+(0x\[0-9a-f\]+\\s+in)?\\s+myo_attach_gdb_wrapper.*at.*${srcfile2}:4.*" "up 4"
gdb_test "info locals" ".*bp = 1\r\nloop = 1.*" "info locals 4"



# 2) test up/down in a stress test fashion
# ----------------------------------------

for {set i 0} {$i < 12} {incr i} {
    # go one up - no deterministic output expected
    gdb_test "up" ".*" "up - stress $i"
    gdb_test "info locals" ".*" "info locals - stress $i"
}
for {set i 0} {$i < 12} {incr i} {
    # go one down - no deterministic output expected
    gdb_test "down" ".*" "up - stress $i"
    gdb_test "info locals" ".*" "info locals - stress $i"
}

# check that the locals can be still read after going up and down
gdb_test "info locals" ".*bp = 1\r\nloop = 1.*" "info locals - final"

# step out of the endless loop
send_gdb "set var loop = 0\n"

# set a bp to the next offload region
gdb_test "break init_array" ".*" "break"

# check that GDB is still alive and can resume
gdb_test "continue" ".*Breakpoint 2, init_array.*at.*${srcfile}:\\d+.*" "continue"

gdb_exit
offload_cleanup
