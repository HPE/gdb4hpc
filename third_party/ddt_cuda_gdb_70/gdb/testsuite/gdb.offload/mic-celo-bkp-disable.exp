# Test goals: check disabled breakpoints

load_lib "offload.exp"

standard_testfile "msample07.cpp" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"

gdb_test "info break" ".*2\\s+breakpoint\\s+keep\\s+y\\s+0x\[0-9a-f\]+ in MSAMPLE07::MSAMPLE07.*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"].*" "info break 1"
gdb_test_no_output "disable" "disable breakpoint 1"
gdb_test "info break" ".*2\\s+breakpoint\\s+keep\\s+n\\s+0x\[0-9a-f\]+ in MSAMPLE07::MSAMPLE07.*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"].*" "info break 2"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"]"
set match ".*2\\s+breakpoint\\s+keep\\s+n\\s+0x\[0-9a-f\]+ in MSAMPLE07::MSAMPLE07.*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"
set match "${match}\r\n3\\s+breakpoint\\s+keep\\s+y\\s+0x\[0-9a-f\]+ in MSAMPLE07::~MSAMPLE07.*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"].*"
gdb_test "info break" "${match}" "info break 3"
gdb_test_no_output "disable" "disable breakpoint 2"
set match ".*2\\s+breakpoint\\s+keep\\s+n\\s+0x\[0-9a-f\]+ in MSAMPLE07::MSAMPLE07.*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"
set match "${match}\r\n3\\s+breakpoint\\s+keep\\s+n\\s+0x\[0-9a-f\]+ in MSAMPLE07::~MSAMPLE07.*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"].*"
gdb_test "info break" "${match}" "info break 4"

# check that we hit only the new enabled breakpoint
gdb_breakpoint "${srcfile}:[gdb_get_line_number "checkpoint_breakpoint" "${srcfile}"]"
gdb_continue_to_breakpoint "checkpoint_breakpoint" ".*${srcfile}:[gdb_get_line_number "checkpoint_breakpoint" "${srcfile}"].*"

gdb_exit
offload_cleanup
