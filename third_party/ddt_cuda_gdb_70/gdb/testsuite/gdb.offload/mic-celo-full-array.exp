# Test goals: complete modification and evaluation of shared arrays

load_lib "offload.exp"

standard_testfile "msample06.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number " BP2" "${srcfile}"]"
gdb_continue_to_breakpoint " BP2"

set count 4097
for {set i 4059} {$i < $count} {incr i} {
    gdb_test_no_output "set var data\[$i\] = [expr "($i + 1)%16"]" "set var data\[$i\] = ($i + 1)%16"
}

gdb_continue_to_breakpoint " BP2"

set count 4097
for {set i 4059} {$i < $count} {incr i} {
    gdb_test_no_output "set var data\[$i\] = [expr "($i + 9)%16"]" "set var data\[$i\] = ($i + 9)%16"
}

delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number " BP3" "${srcfile}"]"
gdb_continue_to_breakpoint " BP3"

set count 4097
for {set i 4059} {$i < $count} {incr i} {
    gdb_test "print res\[$i\]" "\\\$\\d+ = [expr "($i + 1)%16 + ($i + 9)%16"]" "res\[$i\] == ($i + 1)%16 + ($i + 9)%16"
}

gdb_exit
offload_cleanup
