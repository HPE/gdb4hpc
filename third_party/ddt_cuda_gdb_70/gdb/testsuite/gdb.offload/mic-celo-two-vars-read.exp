# Test goals: test that eval of shared vars which haven't been accessed yet doesn't affect the debuggee

load_lib "offload.exp"

standard_testfile "msample11.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# get to the offloaded function, evaluate the two globals even if they haven't been accessed yet,
# what we really care about is that we do NOT cause problems to the debuggee
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"]"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP4" "${srcfile}"]"

# continue until the values have been actually accessed, now the evaluation must work
gdb_continue_to_breakpoint "continue to BP1"

gdb_test "p global_A" "\\\$\\d+ = 42" "global_A == 42"
gdb_test "p global_B" "\\\$\\d+ = 6" "global_A == 6"

# go back to the host and then return to the offloaded function, check we didn't actually cause
# anything bad to the debuggee
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP6" "${srcfile}"]"
gdb_continue_to_breakpoint "continue to BP6"

delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP4" "${srcfile}"]"
gdb_continue_to_breakpoint "continue to BP4"

gdb_test "p global_A" "\\\$\\d+ = 45" "global_A == 45"
gdb_test "p global_B" "\\\$\\d+ = 11" "global_A == 11"

gdb_exit
offload_cleanup
