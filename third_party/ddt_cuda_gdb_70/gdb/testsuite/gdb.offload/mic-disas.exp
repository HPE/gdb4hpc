# Test goals: check that the disas command doesn't crash the target
#             debugger.

load_lib "offload.exp"

standard_testfile "cilk-for-simple.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}


if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
send_gdb "set var loop = 1\n"

gdb_test "disas" "Dump of assembler code for function myo_attach_gdb_wrapper.*" "disas"
gdb_test "disas init_array" "Dump of assembler code for function init_array.*" "disas init_array"
gdb_test "disas myo_attach_gdb" "Dump of assembler code for function myo_attach_gdb.*" "disas myo_attach_gdb"

# check we have still run control
gdb_test "break" "Breakpoint 2 .*$srcfile2, line 4." "set breakpoint to validate run control"
gdb_test "continue" ".*volatile int bp.*" "continue to breakpoint to validate run control"

gdb_exit
offload_cleanup
