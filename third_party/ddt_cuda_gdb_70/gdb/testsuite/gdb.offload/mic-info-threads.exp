# Test goals: the "info thread" command can be executed and does not crash

load_lib "offload.exp"

standard_testfile "psample01.c" "pragma_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

set line_num [gdb_get_line_number "endless_loop_breakpoint" "${srcfile2}"]
gdb_test "info thread" "\\\*\\s+\\d+\\s+Thread.*at.*${srcfile2}:${line_num}.*" "info thread"

gdb_exit
offload_cleanup
