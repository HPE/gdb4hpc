#
# Test goals: reading memory at address 0 does not crash the debugger (or the system)
#        Ported from td/tct/nocrash/tct_x_mem_bad

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} ${srcdir}/${subdir}/${srcfile2}" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

#
# Stopped on BP in "attach_default.c:10"
#
send_gdb "set var loop = 1\n"

gdb_test "x /64w 0x0" "0x0:\[\\s\]+Cannot access memory at address 0x0" "x /64w 0x0 => Cannot access memory at address 0x0"
gdb_test "break" "Breakpoint 2 .*$srcfile2, line 4." "set BP2"
gdb_test "continue" ".*Breakpoint 2, .*$srcfile2:4.*" "continue to BP2"

gdb_exit
offload_cleanup
