# Test goals: the "nexti" (ni) command can be executed and does not crash

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
send_gdb "set var loop = 1\n"

for {set i 0} {$i < 16} {incr i} {
    gdb_test "nexti" ".*" "nexti $i"

    # check if the nexti reached the right location inside
    # the loop.

    # mov
    if { [expr {$i % 4}] == 0 } {
        gdb_test "disas" ".*mov.*\(.*rbp\),.*eax.*" "disas $i/0"
    }
    # test
    if { [expr {$i % 4}] == 1 } {
        gdb_test "disas" ".*test.*.*eax,.*eax.*" "disas $i/1"
    }
    # jne
    if { [expr {$i % 4}] == 2 } {
        gdb_test "disas" ".*jne.*myo_attach_gdb_wrapper.*" "disas $i/2"
    }
    # movl
    if { [expr {$i % 4}] == 3 } {
        gdb_test "disas" ".*movl.*\(.*rbp\).*" "disas $i/3"
    }
}

gdb_test "break" ".*Breakpoint 2 at .*:.*${srcfile2}, line 4.*" "break"
gdb_test "cont" ".*volatile int bp = 1.*" "cont"

gdb_exit
offload_cleanup
