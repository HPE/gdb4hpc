# Test goals: test evaluation of an initialized shared var.

load_lib "offload.exp"

standard_testfile "msample01.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "force_read_global" "${srcfile}"]"
gdb_continue_to_breakpoint "force_read_global 1"

gdb_test "print global" "\\\$1 = 44" "global = 44"

gdb_continue_to_breakpoint "force_read_global 2"
gdb_test "print global" "\\\$2 = 46" "global = 46"

gdb_continue_to_breakpoint "force_read_global 3"
gdb_test "print global" "\\\$3 = 48" "global = 48"


gdb_exit
offload_cleanup
