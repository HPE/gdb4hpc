set testfile myo-ownership-host
set srcfile ${testfile}.c
set binfile ${objdir}/${subdir}/${testfile}

if [get_compiler_info ${binfile}] {
    return -1;
}

# Only run with Intel compiler(s)
if ![test_compiler_info "icc-*"] {
    untested "${testfile}.exp: not using an Intel compiler"
    return -1;
}

if  {[gdb_compile "${srcdir}/${subdir}/${srcfile}" "${binfile}" executable {debug}] != ""} {
    untested "${testfile}.exp: could not compile"
    return -1
}

gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_load $binfile

if ![runto_main] then {
    fail "Can't run to main"
    return 0
}

gdb_test "break ${srcfile}:[gdb_get_line_number "bp1"]" \
            "Breakpoint .* at .*${srcfile}.*" \
            "breakpoint bp1"
gdb_continue_to_breakpoint "continue to breakpoint bp1"
# check write to variable _without_ having the ownership.
gdb_test "set shared_var = 42" ".*Cannot access memory at address 0x.*" "set shared_var without ownership"
# check that the value didn't change.
gdb_test "p shared_var" ".*= 1" "check write without ownership didn't change shared variable"

gdb_test "break ${srcfile}:[gdb_get_line_number "bp2"]" \
            "Breakpoint .* at .*${srcfile}.*" \
            "breakpoint bp2"
gdb_continue_to_breakpoint "continue to breakpoint bp2"
# check write to variable _with_ having the ownership.
gdb_test_no_output "set shared_var = 42" "set shared_var to 42 while having ownership"
# check that the value changed.
gdb_test "p shared_var" ".*= 42" "check write with ownership changed shared variable"

# Run over target side write and stop on host side again. The ownership should be on the target now.
gdb_test "break ${srcfile}:[gdb_get_line_number "bp3"]" \
            "Breakpoint .* at .*${srcfile}.*" \
            "breakpoint bp3"
gdb_continue_to_breakpoint "continue to breakpoint bp3"
# check write to variable _without_ having the ownership.
gdb_test "set shared_var = 42" ".*Cannot access memory at address 0x.*" "set shared_var without ownership"
# check that the value didn't change.
gdb_test "p shared_var" ".*= 1311" "check write without ownership didn't change shared variable"

return 0
