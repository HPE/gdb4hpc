load_lib "myo.exp"
set testfile "myo-bkp-disable"
set binfile  ${objdir}/${subdir}/${testfile}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/celo_simple_class.cpp ${srcdir}/${subdir}/attach_default.c" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

myo_initialize $binfile

myo_attach_sequence "cpp"

gdb_test "break celo_simple_class.cpp:24" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 24"
gdb_test_no_output "disable" "disable breakpoint 1"

gdb_test "break celo_simple_class.cpp:34" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 34"
gdb_test_no_output "disable" "disable breakpoint 2"

# this is the one we want to hit
gdb_test "break celo_simple_class.cpp:53" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 53"

gdb_test "continue" ".*volatile int checkdummy = 1;.*" "cont"

gdb_exit

myo_cleanup
