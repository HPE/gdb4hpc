# Test goals: check evaluations inside constructors/destructors

load_lib "offload.exp"

standard_testfile "msample07.cpp" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# check bt inside constructor
gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_constructor"

# match the known backtrace
set match "#0  MSAMPLE07::MSAMPLE07 \\\(this=.*\\\) at .*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"
set match "${match}\r\n#1.*at .*${srcfile}:[gdb_get_line_number "MSAMPLE07_local_create" "${srcfile}"]"
set match "${match}\r\n#2.*at .*${srcfile}:[gdb_get_line_number "localclass_entry" "${srcfile}"].*"

gdb_test "bt" "${match}" "bt constructor"

# check bt inside destructor
gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_destructor"

# match the known backtrace
set match "#0  MSAMPLE07::~MSAMPLE07 \\\(this=.*\\\) at .*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"]"
set match "${match}\r\n#1.*at .*${srcfile}:[gdb_get_line_number "localclass_end" "${srcfile}"]"
set match "${match}\r\n#2.*at .*${srcfile}:[gdb_get_line_number "localclass_entry" "${srcfile}"].*"

gdb_test "bt" "${match}" "bt destructor"


# check that we still have run control
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "checkpoint_breakpoint" "${srcfile}"]"
gdb_continue_to_breakpoint "checkpoint_breakpoint"

gdb_exit
offload_cleanup
