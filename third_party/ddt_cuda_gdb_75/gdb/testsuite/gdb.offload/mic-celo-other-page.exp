# Test goals: modification of a value in a different page than the most recent one accessed

load_lib "offload.exp"

standard_testfile "msample06.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP4" "${srcfile}"]"
gdb_continue_to_breakpoint "BP4"

# a page is 4k on MIC, we will access at least 4096*4+1 bytes away (4 pages)
gdb_test_no_output "set in1\[4096\]=42.0" "set in1\[4096\]=42.0"
gdb_test_no_output "set in2\[4096\]=17.0" "set in1\[4096\]=17.0"

delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP3" "${srcfile}"]"
gdb_continue_to_breakpoint "BP3"

gdb_test "p res\[4096\]" "\\\$\\d+ = 59.0" "print member 4096 of array res"

gdb_exit
offload_cleanup
