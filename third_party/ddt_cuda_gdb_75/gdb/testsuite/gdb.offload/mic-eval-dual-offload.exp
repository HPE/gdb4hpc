# Test goals: check evaluations on arrays "left behind" by a previous 
#             offload block.

load_lib "offload.exp"

standard_testfile "psample07.c" "pragma_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

set num_iterations 15

gdb_breakpoint "${srcfile}:[gdb_get_line_number "second_offload_inside_for_loop" "${srcfile}"]"
gdb_continue_to_breakpoint "second_offload_inside_for_loop"

for {set i 0} {$i < $num_iterations} {incr i} {
    gdb_test "print array1\[$i\]" "\\\$\\d+ = [expr "$i+1"]" "array1\[$i\] = [expr "$i+1"]"
}

gdb_exit
offload_cleanup
