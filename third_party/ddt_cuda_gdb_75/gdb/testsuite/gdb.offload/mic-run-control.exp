# Test goals: check most basic run control and print breakpoint info

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
gdb_test_no_output "set var loop = 1" "set var loop = 1"

gdb_test "break" ".*Breakpoint 2 at .*:.*${srcfile2}, line 4.*" "set break"
gdb_test "info break" ".*2\[\\\s\]+breakpoint.* at .*$srcfile2:4" "info break 1"

gdb_test "cont" ".*volatile int bp = 1.*" "cont"
gdb_test "info break" ".*2\[\\\s\]+breakpoint.* at .*$srcfile2:4.*breakpoint already hit 1 time" "info break 2"

#
# delete all breakpoints
#
send_gdb "delete breakpoints\n"
gdb_expect {
    -re "Delete all breakpoints.* $" {
        send_gdb "y\n"
        gdb_expect {
            -re ".*$gdb_prompt $" {
                pass "delete all breakpoints"
            }
            timeout {
                fail "delete all breakpoints (timeout)"
            }
        }
    }
    timeout {
        fail "delete all breakpoints (timeout)"
    }
}

gdb_test "info break" "No breakpoints or watchpoints." "info break 3"

gdb_exit
offload_cleanup
