# Test goals: test the debugger sizeof implementation

load_lib "offload.exp"

standard_testfile "psample02.cpp" "pragma_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "dummy_for_breakpoint" "${srcfile}"]"
gdb_continue_to_breakpoint "dummy_for_breakpoint"

gdb_test "print boolSize==sizeof(bool)" \
            "\\\$1 = true" "bool size check"
gdb_test "print charSize==sizeof(char)" \
            "\\\$2 = true" "char size check"
gdb_test "print shortSize==sizeof(short)" \
            "\\\$3 = true" "short size check"
gdb_test "print intSize==sizeof(int)" \
            "\\\$4 = true" "int size check"
gdb_test "print longSize==sizeof(long)" \
            "\\\$5 = true" "long size check"
gdb_test "print longlongSize==sizeof(long long)" \
            "\\\$6 = true" "long long size check"
gdb_test "print floatSize==sizeof(float)" \
            "\\\$7 = true" "float size check"
gdb_test "print doubleSize==sizeof(double)" \
            "\\\$8 = true" "double size check"
gdb_test "print longdoubleSize==sizeof(long double)" \
            "\\\$9 = true" "long double size check"
gdb_test "print intptrSize==sizeof(int*)" \
            "\\\$10 = true" "int* size check"
gdb_test "print wchar_tSize==sizeof(wchar_t)" \
            "\\\$11 = true" "wchar_t size check"

gdb_exit
offload_cleanup
