if { [skip_fortran_tests] } { continue }

standard_testfile type.f90

if { [prepare_for_testing ${testfile}.exp ${testfile} \
                          ${srcfile} {debug f90}] } {
    return -1
}

if ![runto MAIN__] {
    fail "run to MAIN__"
    return
}

gdb_breakpoint [gdb_get_line_number "bp1"]
gdb_continue_to_breakpoint "bp1"

set t1_i "integer\\\(kind=4\\\) :: t1_i"
set t1_r "real\\\(kind=4\\\) :: t1_r"


# In gdb >= 7.7 "whatis XXX" (where XXX is an class) will show that type
# in detail (similar to the output to "ptype XXX").
# Until then just test for the gdb 7.6.x output (which will be the name
# of the class but not a breakdown of its members):

# gdb >= 7.7:

#gdb_test "whatis t1" \
#  "type = Type t1\r\n${t1_i}\r\n${t1_r}\r\nEnd Type t1" \
#  "whatis t1"
#gdb_test "whatis t1v" \
#  "type = Type t1\r\n${t1_i}\r\n${t1_r}\r\nEnd Type t1" \
#  "whatis t1v"
#gdb_test "ptype t1" \
#  "type = Type t1\r\n    ${t1_i}\r\n    ${t1_r}\r\nEnd Type t1"
#gdb_test "ptype t1v" \
#  "type = Type t1\r\n    ${t1_i}\r\n    ${t1_r}\r\nEnd Type t1"

# gdb 7.6.2:

gdb_test "whatis t1" \
  "type = TYPE\\(t1\\)"
gdb_test "whatis t1v" \
  "type = TYPE\\(t1\\)"
gdb_test "ptype t1" \
  "type = TYPE t1\r\n    ${t1_i}\r\n    ${t1_r}\r\nEND TYPE t1"
gdb_test "ptype t1v" \
  "type = TYPE t1\r\n    ${t1_i}\r\n    ${t1_r}\r\nEND TYPE t1"
