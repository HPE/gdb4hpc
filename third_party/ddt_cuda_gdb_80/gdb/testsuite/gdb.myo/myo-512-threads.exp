load_lib "myo.exp"
set testfile "myo-512-threads"
set binfile  ${objdir}/${subdir}/${testfile}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/myo-cilk-for-simple.c ${srcdir}/${subdir}/attach_default.c" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

myo_initialize $binfile

myo_attach_sequence "c"

gdb_test "break myo-cilk-for-simple.c:14" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 14"
gdb_test "continue" ".*volatile int num_threads = 2;.*" "cont"
gdb_test_no_output "set num_threads=512" "set num_threads=512"

gdb_test "break myo-cilk-for-simple.c:23" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 23"
gdb_test "continue" ".*arr1.*i.* = i.*" "cont"

# check we still have run control
gdb_test_no_output "delete 1" "delete"
gdb_test_no_output "delete 2" "delete"
gdb_test_no_output "delete 3" "delete"
gdb_test "break myo-cilk-for-simple.c:28" ".*Breakpoint .* at .*: file .*, line .*" "set bp @ 28"
gdb_test "continue" ".*superdummy = 0;.*" "cont"

gdb_exit

myo_cleanup
