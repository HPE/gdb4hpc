load_lib "myo.exp"
set testfile "myo-512-threads"
set binfile  ${objdir}/${subdir}/${testfile}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/myo-cilk-for-simple.c ${srcdir}/${subdir}/attach_default.c" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

myo_initialize $binfile

myo_attach_sequence "c"

gdb_test "backtrace" ".*0  attach_gdb_wrapper .*at .*attach_default.c:4.*" "show backtrace"

gdb_exit

myo_cleanup
