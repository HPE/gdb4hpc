#
# Test goals: breakpoints can be set at the current execution point, the "clear"
#        command can be executed, the debugger does not crash
#        Ported from td/tct/nocrash/tct_x_bkp_clear

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} ${srcdir}/${subdir}/${srcfile2}" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

#
# Stopped on BP in "myo_attach_default.c"
#
send_gdb "set var loop = 1\n"

#
# Go to the next line, set BP in this line, clear and check BP info
#
send_gdb "next\n"
gdb_test "break" "Breakpoint 2 at 0x.* file .*$srcfile2, line 3." "set BP2"
gdb_test "clear" "Deleted breakpoint 2.*" "clear BP2"
gdb_test "info break" "No breakpoints or watchpoints." "BP info after clear BP2"

#
# Repeat setting BP and clear
#
send_gdb "next\n"
gdb_test "break" "Breakpoint 3 at 0x.* file .*$srcfile2, line 4." "set BP3"
gdb_test "clear" "Deleted breakpoint 3.*" "clear BP3"
gdb_test "info break" "No breakpoints or watchpoints." "BP info after clear BP3"

#
# Go to next line, set BP in this line, clear and check BP info
#
send_gdb "next\n"
gdb_test "break" "Breakpoint 4 at 0x.* file .*$srcfile2, line 3." "set BP4"
gdb_test "clear" "Deleted breakpoint 4.*" "clear BP4"
gdb_test "info break" "No breakpoints or watchpoints." "BP info after clear BP4"

#
# Repeat setting BP and clear
#
send_gdb "next\n"
gdb_test "break" "Breakpoint 5 at 0x.* file .*$srcfile2, line 4." "set BP5"
gdb_test "clear" "Deleted breakpoint 5.*" "clear BP5"
gdb_test "info break" "No breakpoints or watchpoints." "BP info after clear BP5"

#
# Repeat setting BP and clear
#
send_gdb "next\n"
gdb_test "break" "Breakpoint 6 at 0x.* file .*$srcfile2, line 3." "set BP6"
gdb_test "clear" "Deleted breakpoint 6.*" "clear BP6"
gdb_test "info break" "No breakpoints or watchpoints." "BP info after clear BP6"

#
# Repeat setting BP and clear
#
send_gdb "next\n"
gdb_test "break" "Breakpoint 7 at 0x.* file .*$srcfile2, line 4." "set BP7"
gdb_test "clear" "Deleted breakpoint 7.*" "clear BP7"
gdb_test "info break" "No breakpoints or watchpoints." "BP info after clear BP7"

gdb_exit

offload_cleanup
