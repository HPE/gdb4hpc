# Test goals: check breakpoints on functions which are not completely offloaded.
#             The first breakpoint is not a valid position for the target side,
#             as there is no target code available. The test should ensure that
#             the target debugger finds the next available target code location,
#             which is available.

load_lib "offload.exp"

standard_testfile "psample01.c" "pragma_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

# this breakpoint should not be hit at all as it was set on
# the host side. Since we are debugging the target part
# the target debugger part should not stop here.
gdb_breakpoint "psample01"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "breakpoint_psample01_init" "${srcfile}"]"
gdb_test "continue" ".*Breakpoint 2.*#pragma offload target\\\(mic\\\).*" "continued to the offloaded region"

# check that we can reach bp3
gdb_test "continue" ".*Breakpoint 3.*d = 0.0.*" "continued to breakpoint in offload region"

gdb_exit
offload_cleanup
