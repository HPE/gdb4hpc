# Test goals: test breakpoints on function names.

load_lib "offload.exp"

standard_testfile "psample04.c" "pragma_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "dummy_bp_1" "${srcfile}"]"
gdb_continue_to_breakpoint "dummy_bp_1"

gdb_breakpoint "psub_d"
gdb_continue_to_breakpoint "psub_d"

gdb_test "print val_d" "\\\$1 = 100" "val_d == 100.0"

gdb_exit
offload_cleanup
