# Test goals: test repeatedly breakpoints in and out of an openmp parallel
#             for region

load_lib "offload.exp"

standard_testfile "msample04.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "before_omp_loop" "${srcfile}"]"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "omp_loop_bp2" "${srcfile}"]"

for {set i 0} {$i < 8} {incr i} {
    gdb_continue_to_breakpoint "before_omp_loop"
    gdb_test "print total" "\\\$\\d+ = 42" "print total before omp loop ${i}"

    gdb_test "enable breakpoints 3" ".*" "enable breakpoints 3 iteration ${i}"
    gdb_test "disable breakpoints 2" ".*" "enable breakpoints 2 iteration ${i}"

    gdb_continue_to_breakpoint "omp_loop_bp2"
    gdb_test "print total > 42" "\\$\\d+ = 1" "print total inside omp loop ${i}"

    gdb_test "disable breakpoints 3" ".*" "disable breakpoints 3 iteration ${i}"
    gdb_test "enable breakpoints 2" ".*" "enable breakpoints 2 iteration ${i}"
}

gdb_exit
offload_cleanup
