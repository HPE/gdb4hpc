# Test goals: check evaluations inside constructors/destructors

load_lib "offload.exp"

standard_testfile "msample07.cpp" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# check the constructor values
gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_constructor"

gdb_test "print fieldi" "\\\$\\d+ = 5" "constructor - print fieldi == 5"
gdb_test "print fieldd" "\\\$\\d+ = 8888.3" "constructor - print fieldd == 8888.3"
gdb_test "print fieldf" "\\\$\\d+ = 9.3" "constructor - print fieldf == 9.3"
gdb_test "print fieldc" "\\\$\\d+ = 65 'A'" "constructor - print fieldc == 'A'"
gdb_test "print fields" "\\\$\\d+ = 127" "constructor - print fields == 172"

# check the destructor values
gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_destructor"
gdb_test "print fieldi" "\\\$\\d+ = -45" "destructor - print fieldi == -45"
gdb_test "print fieldd" "\\\$\\d+ = 29.3" "destructor - print fieldd == 29.3"
gdb_test "print fieldf" "\\\$\\d+ = 42.3" "destructor - print fieldf == 42.3"
gdb_test "print fieldc" "\\\$\\d+ = 66 'B'" "destructor - print fieldc == 'B'"
gdb_test "print fields" "\\\$\\d+ = 13" "destructor - print fields == 13"

gdb_exit
offload_cleanup
