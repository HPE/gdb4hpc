# Test goals: check we can evaluate locals walking the stack inside
#             constructors/destructors

load_lib "offload.exp"

standard_testfile "msample07.cpp" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# constructor
gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_constructor"
gdb_test "print fieldi" "\\\$\\d+ = 5" "constructor - print fieldi == 5 (up)"
gdb_test "up" "#1.*${srcfile}:[gdb_get_line_number "MSAMPLE07_local_create" "${srcfile}"].*" "constructor - up 1"
gdb_test "print superdummy" "\\\$\\d+ = 1" "constructor - print superdummy == 1 (1)"
gdb_test "up" "#2.*${srcfile}:[gdb_get_line_number "localclass_entry" "${srcfile}"].*" "constructor - up 2"
gdb_test "print superdummy != 1" "\\\$\\d+ = true" "constructor - print superdummy != 1"

gdb_test "down" "#1.*${srcfile}:[gdb_get_line_number "MSAMPLE07_local_create" "${srcfile}"].*" "constructor - down 1"
gdb_test "print superdummy" "\\\$\\d+ = 1" "constructor - print superdummy == 1 (2)"
gdb_test "down" "#0  MSAMPLE07::MSAMPLE07 \\\(this=.*\\\) at .*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"].*" "constructor - down 2"
gdb_test "print fieldi" "\\\$\\d+ = 5" "constructor - print fieldi == 5 (down)"

delete_breakpoints
# destructor
gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_destructor"
gdb_test "print fieldi" "\\\$\\d+ = -45" "constructor - print fieldi == 5 (up)"
gdb_test "up" "#1.*${srcfile}:[gdb_get_line_number "localclass_end" "${srcfile}"].*" "destructor - up 1"
gdb_test "print superdummy" "\\\$\\d+ = 2" "destructor - print superdummy == 2"
gdb_test "up" "#2.*${srcfile}:[gdb_get_line_number "localclass_entry" "${srcfile}"].*" "destructor - up 2"
gdb_test "print superdummy != 2" "\\\$\\d+ = true" "destructor - print superdummy != 2"

gdb_test "down" "#1.*${srcfile}:[gdb_get_line_number "localclass_end" "${srcfile}"].*" "destructor - down 1"
gdb_test "print superdummy" "\\\$\\d+ = 2" "destructor - print superdummy == 2"
gdb_test "down" "#0  MSAMPLE07::~MSAMPLE07 \\\(this=.*\\\) at .*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"].*" "destructor - down 2"
gdb_test "print fieldi" "\\\$\\d+ = -45" "constructor - print fieldi == 5 (down)"

# check that we still have run control
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "checkpoint_breakpoint" "${srcfile}"]"
gdb_continue_to_breakpoint "checkpoint_breakpoint"

gdb_exit
offload_cleanup
