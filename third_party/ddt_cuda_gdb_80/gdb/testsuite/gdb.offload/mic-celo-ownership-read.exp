# Test goals: check ownership of _Shared variables

load_lib "offload.exp"

standard_testfile "msample08.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# check var value after it has been read in the debuggee
gdb_breakpoint "${srcfile}:[gdb_get_line_number "here my_shared MUST be evaluated correctly" "${srcfile}"]"
gdb_continue_to_breakpoint "continue 1"
gdb_test "p my_shared" "\\\$\\d+ = 1.0" "my_shared == 1.0"

gdb_exit
offload_cleanup
