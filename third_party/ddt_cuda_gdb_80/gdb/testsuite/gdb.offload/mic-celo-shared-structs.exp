# Test goals: evaluation of a shared struct using a shared pointer

load_lib "offload.exp"

standard_testfile "msample09.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP1" "${srcfile}"]"
gdb_continue_to_breakpoint "continue"

gdb_test "p SCI.sc" "\\\$\\d+ = 0x70" "SCI.sc == 0x70"
gdb_test "p SCI.si" "\\\$\\d+ = 0x70000000" "SCI.si == 0x70000000"
gdb_test "p SCI.sl" "\\\$\\d+ = 0x7000000000000000l" "SCI.sl == 0x7000000000000000l"
gdb_test "p SCI.sll" "\\\$\\d+ = 0x7000000000000000l" "SCI.sll == 0x7000000000000000l"
gdb_test "p SCI.f" "\\\$\\d+ = 10.0" "SCI.f == 10.0"
gdb_test "p SCI.d" "\\\$\\d+ = 10101010.0" "SCI.d == 10101010.0"
gdb_test "p SCI.ld" "\\\$\\d+ = 1010101010101010.0" "SCI.ld == 1010101010101010.0"


gdb_exit
offload_cleanup
