# Test goals: check we can survive walking the stack inside
#             constructors/destructors

load_lib "offload.exp"

standard_testfile "msample07.cpp" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_constructor"

gdb_test "info locals" "No locals." "constructor - info locals"
gdb_test "up" "#1.*${srcfile}:[gdb_get_line_number "MSAMPLE07_local_create" "${srcfile}"].*" "constructor - up 1"
gdb_test "info locals" "superdummy = 1.*" "constructor - info locals - up 1"

# Normaly GDB will stop at the call of the "localclass" function.
# Since the target debugger does not have access to the code
# of the host side, it will stop at the entrence of the "localclass"
# function.
gdb_test "up" "#2.*${srcfile}:[gdb_get_line_number "localclass_entry" "${srcfile}"].*" "constructor - up 2"
gdb_test "info locals" "superdummy = \\d+.*" "constructor - info locals - up 2"

# can be anything, not in scope anymore
gdb_test "up" ".*" "constructor - up 3"

# can be anything, not in scope anymore
gdb_test "up" ".*" "constructor - up 4"

# can be anything, not in scope anymore
gdb_test "up" ".*" "constructor - up 5"

# can be anything, not in scope anymore
gdb_test "up" ".*" "constructor - up 6"

# can be anything, not in scope anymore
gdb_test "up" ".*" "constructor - up 7"

gdb_test "down" ".*" "constructor - down 1"
gdb_test "down" ".*" "constructor - down 2"
gdb_test "down" ".*" "constructor - down 3"
gdb_test "down" ".*" "constructor - down 4"
gdb_test "down" ".*" "constructor - down 5"
gdb_test "down" ".*" "constructor - down 6"
gdb_test "down" ".*" "constructor - down 7"
gdb_test "bt" ".*#0  MSAMPLE07::MSAMPLE07 \\\(this=.*\\\) at .*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_constructor" "${srcfile}"].*" "constructor - bt"


delete_breakpoints

gdb_breakpoint "${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"]"
gdb_continue_to_breakpoint "fielddummy_breakpoint_destructor"

gdb_test "info locals" "No locals." "destructor - info locals"
gdb_test "up" "#1.*${srcfile}:[gdb_get_line_number "localclass_end" "${srcfile}"].*" "destructor - up 1"
gdb_test "info locals" "superdummy = 2.*" "destructor - info locals - up 1"

gdb_test "up" "#2.*${srcfile}:[gdb_get_line_number "localclass_entry" "${srcfile}"].*" "destructor - up 2"
gdb_test "info locals" "superdummy = \\d+.*" "destructor - info locals - up 2"

# can be anything, not in scope anymore
gdb_test "up" ".*" "destructor - up 3"

# can be anything, not in scope anymore
gdb_test "up" ".*" "destructor - up 4"

# can be anything, not in scope anymore
gdb_test "up" ".*" "destructor - up 5"

# can be anything, not in scope anymore
gdb_test "up" ".*" "destructor - up 6"

# can be anything, not in scope anymore
gdb_test "up" ".*" "destructor - up 7"

gdb_test "down" ".*" "destructor - down 1"
gdb_test "down" ".*" "destructor - down 2"
gdb_test "down" ".*" "destructor - down 3"
gdb_test "down" ".*" "destructor - down 4"
gdb_test "down" ".*" "destructor - down 5"
gdb_test "down" ".*" "destructor - down 6"
gdb_test "down" ".*" "destructor - down 7"
gdb_test "bt" ".*#0  MSAMPLE07::~MSAMPLE07 \\\(this=.*\\\) at .*${srcfile}:[gdb_get_line_number "fielddummy_breakpoint_destructor" "${srcfile}"].*" "destructor - bt"

gdb_exit
offload_cleanup
