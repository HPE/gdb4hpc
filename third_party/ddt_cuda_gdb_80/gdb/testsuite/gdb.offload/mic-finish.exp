# Test goals: check the "finish" command from a single function call.

load_lib "offload.exp"

standard_testfile "psample03.c" "pragma_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "breakpoint_at_return" "${srcfile}"]"
gdb_continue_to_breakpoint "breakpoint_at_return"

delete_breakpoints

gdb_breakpoint "${srcfile}:[gdb_get_line_number "last_user_offload_statement" "${srcfile}"]"
set expected_line [gdb_get_line_number "breakpoint_at_return" "${srcfile}"]
gdb_test "info thread" ".*\\\*.*psample03 .* at .*${srcfile}:${expected_line}.*" "info thread"
set expected_line [gdb_get_line_number "after_psample03" "${srcfile}"]
gdb_test "finish" ".*${expected_line}.*val = 0.*" "finish"
gdb_test "info thread" ".*\\\*.* at .*${srcfile}:${expected_line}.*" "info thread"

gdb_exit
offload_cleanup
