# Test goals: float values on the stack can be evaluated correctly.

load_lib "offload.exp"

standard_testfile "psample01.c" "pragma_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "psample01_f2_call" "${srcfile}"]"
gdb_continue_to_breakpoint "psample01_f2_call"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "breakpoint_psample01_f1" "${srcfile}"]"
gdb_continue_to_breakpoint "breakpoint_psample01_f1"

gdb_test "print a == 1.0" "\\\$1 = 1" "a == 1.0"

set expected_line [gdb_get_line_number "breakpoint_psample01_f2" "${srcfile}"]
gdb_test "up" "#1 .* psample01_f2 \\(a=2, b=1\\) at .*${srcfile}:${expected_line}.*" "up1"
gdb_test "print a == 2.0" "\\\$2 = 1" "a == 2.0 after up1"

set expected_line [gdb_get_line_number "psample01_f2_call" "${srcfile}"]
gdb_test "up" "#2 .*psample01 .* at .*${srcfile}:${expected_line}.*" "up2"
gdb_test "print a == 1.0" "\\\$3 = 1" "a == 1.0 after up2"

set expected_line [gdb_get_line_number "breakpoint_psample01_f2" "${srcfile}"]
gdb_test "down" "#1 .* psample01_f2 \\(a=2, b=1\\) at .*${srcfile}:${expected_line}.*" "down1"
set expected_line [gdb_get_line_number "breakpoint_psample01_f1" "${srcfile}"]
gdb_test "down" "#0  psample01_f1 \\(a=1\\) at .*${srcfile}:${expected_line}.*" "down2"
gdb_test "print a == 1.0" "\\\$4 = 1" "a == 1.0 after two times down"

# going down more levels than what currently exists must not hurt
gdb_test "down" "Bottom .* frame selected; you cannot go down." "down3"
gdb_test "down" "Bottom .* frame selected; you cannot go down." "down4"
gdb_test "down" "Bottom .* frame selected; you cannot go down." "down5"

gdb_test "print a == 1.0" "\\\$5 = 1" "a == 1.0 after three times down"

gdb_exit
offload_cleanup
