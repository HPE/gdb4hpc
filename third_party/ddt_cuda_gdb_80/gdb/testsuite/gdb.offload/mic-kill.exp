# Test goals: debugger is able to kill the debuggee in an offload scenario.

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_test "kill" "^y" "kill" "Kill the program being debugged\\? \\(y or n\\) $" "y"
# check if the offload part on the target exists
set offload_main_exists [ exec ssh -q $mic_card_address ps aux | gawk "{ if (\$4 ~/offload_main/) { print \$1; } }" ]
if { $offload_main_exists == "" } {
    pass "offload_main process doesn't exists after kill"
} else {
    fail "offload_main process doesn't exists after kill"
}

set target_part_exists [ exec ps -eo pid,comm | gawk "{ if (\$2 ~/mic-kill/) { print \$1; } }" ]
if { $target_part_exists == "" } {
    pass "host process doesn't exists after kill"
} else {
    fail "host process doesn't exists after kill"
}

gdb_exit
offload_cleanup
