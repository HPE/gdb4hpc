#
# Test goals: stack memory can be written and does not crash the debugger
#        Ported from td/tct/nocrash/tct_x_mem_write

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

set rsp "\$rsp"
set mtmp "\$mtmp"
set mtmpneg "\$mtmpneg"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} ${srcdir}/${subdir}/${srcfile2}" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
#
send_gdb "set var loop = 1\n"

# Workaround: gdb does not print the value of an address in when doing "x /g ADDRESS in
# the correct hexadecimal format. After a print /x command everyting works fine.
gdb_test "print /x 0x0" "\\\$\\d+ = 0x0" "GDB hexadecimal workaround"
gdb_test "x /g $rsp" "0x\[0-9a-f\]+:\[\\\t\]0x0000000100000001" "x /g $rsp == <address>: 0x0000000100000001"
gdb_test_no_output "set var $mtmp = *((long*)($rsp))" "set var $mtmp = *((long*)($rsp))"
gdb_test "print /x $mtmp" "\\\$\\d+ = 0x100000001" "print /x $mtmp == 0x100000001"

gdb_test_no_output "set var $mtmpneg = $mtmp ^ 0xffffffffffffffff" "set var $mtmpneg = $mtmp ^ 0xffffffffffffffff"
gdb_test_no_output "set *((long*)$rsp) = $mtmpneg" "set *((long*)$rsp) = $mtmpneg"
gdb_test "x /g $rsp" "0x\[0-9a-f\]+:\[\\\t\]0xfffffffefffffffe" "x /g $rsp == <address>: 0xfffffffefffffffe"

gdb_test_no_output "set *((long*)$rsp) = $mtmp" "set *((long*)$rsp) = $mtmp"
gdb_test "x /g $rsp" "0x\[0-9a-f\]+:\[\\\t\]0x0000000100000001" "x /g $rsp == <address>: 0x0000000100000001"

gdb_test "break" "Breakpoint 2 .*$srcfile2, line 4." "set BP2"
gdb_test "continue" ".*volatile int bp.*" "continue to BP2"

gdb_exit
offload_cleanup
