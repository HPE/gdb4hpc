# Test goals: check that MIC vector mask registers can be read and written

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
#
gdb_test_no_output "set var loop = 1" "set var loop = 1"

# Check that we can read registers
#
gdb_test "info reg \$k0" "k0\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k0 == <value> "
gdb_test "info reg \$k1" "k1\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k1 == <value> "
gdb_test "info reg \$k2" "k2\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k2 == <value> "
gdb_test "info reg \$k3" "k3\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k3 == <value> "
gdb_test "info reg \$k4" "k4\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k4 == <value> "
gdb_test "info reg \$k5" "k5\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k5 == <value> "
gdb_test "info reg \$k6" "k6\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k6 == <value> "
gdb_test "info reg \$k7" "k7\\s+0x\[0-9a-f\]+\\s+\[0-9\]+" "info reg \$k7 == <value> "

# Save the content of registers
# (register k0 is always 0, we can't modify it)
gdb_test_no_output "set var \$mk1 = \$k1" "set var \$mk1 = \$k1"
gdb_test_no_output "set var \$mk2 = \$k2" "set var \$mk2 = \$k2"
gdb_test_no_output "set var \$mk3 = \$k3" "set var \$mk3 = \$k3"
gdb_test_no_output "set var \$mk4 = \$k4" "set var \$mk4 = \$k4"
gdb_test_no_output "set var \$mk5 = \$k5" "set var \$mk5 = \$k5"
gdb_test_no_output "set var \$mk6 = \$k6" "set var \$mk6 = \$k6"
gdb_test_no_output "set var \$mk7 = \$k7" "set var \$mk7 = \$k7"

# Assign value to register
#
gdb_test_no_output "set var \$k1 = 0xf0f0" "set var \$k1 = 0xf0f0"
gdb_test_no_output "set var \$k2 = 0x0f0f" "set var \$k2 = 0x0f0f"
gdb_test_no_output "set var \$k3 = 0xe0e0" "set var \$k3 = 0xe0e0"
gdb_test_no_output "set var \$k4 = 0x0e0e" "set var \$k4 = 0x0e0e"
gdb_test_no_output "set var \$k5 = 0xd0d0" "set var \$k5 = 0xd0d0"
gdb_test_no_output "set var \$k6 = 0x0d0d" "set var \$k6 = 0x0d0d"
gdb_test_no_output "set var \$k7 = 0xc0c0" "set var \$k7 = 0xc0c0"

# Check that assigned value is corrrect
#
gdb_test "info reg \$k0" "k0\\s+0x0\\s+0" "info reg \$k0 == 0x0 0"
gdb_test "info reg \$k1" "k1\\s+0xf0f0\\s+\[-0-9\]+" "info reg \$k1 == 0xf0f0 <value>"
gdb_test "info reg \$k2" "k2\\s+0xf0f\\s+\[-0-9\]+" "info reg \$k2 == 0x0f0f <value>"
gdb_test "info reg \$k3" "k3\\s+0xe0e0\\s+\[-0-9\]+" "info reg \$k3 == 0xe0e0 <value>"
gdb_test "info reg \$k4" "k4\\s+0xe0e\\s+\[-0-9\]+" "info reg \$k4 == 0x0e0e <value>"
gdb_test "info reg \$k5" "k5\\s+0xd0d0\\s+\[-0-9\]+" "info reg \$k5 == 0xd0d0 <value>"
gdb_test "info reg \$k6" "k6\\s+0xd0d\\s+\[-0-9\]+" "info reg \$k6 == 0x0d0d <value>"
gdb_test "info reg \$k7" "k7\\s+0xc0c0\\s+\[-0-9\]+" "info reg \$k7 == 0xc0c0 <value>"

# Restore registers
#
gdb_test_no_output "set var \$k1 = \$mk1" "set var \$k1 = \$mk1"
gdb_test_no_output "set var \$k2 = \$mk2" "set var \$k2 = \$mk2"
gdb_test_no_output "set var \$k3 = \$mk3" "set var \$k3 = \$mk3"
gdb_test_no_output "set var \$k4 = \$mk4" "set var \$k4 = \$mk4"
gdb_test_no_output "set var \$k5 = \$mk5" "set var \$k5 = \$mk5"
gdb_test_no_output "set var \$k6 = \$mk6" "set var \$k6 = \$mk6"
gdb_test_no_output "set var \$k7 = \$mk7" "set var \$k7 = \$mk7"

# Check restored values
#
gdb_test "print \$k1 == \$mk1" "\\$\\d+ = 1" "\$k1 == \$mk1"
gdb_test "print \$k2 == \$mk2" "\\$\\d+ = 1" "\$k2 == \$mk2"
gdb_test "print \$k3 == \$mk3" "\\$\\d+ = 1" "\$k3 == \$mk3"
gdb_test "print \$k4 == \$mk4" "\\$\\d+ = 1" "\$k4 == \$mk4"
gdb_test "print \$k5 == \$mk5" "\\$\\d+ = 1" "\$k5 == \$mk5"
gdb_test "print \$k6 == \$mk6" "\\$\\d+ = 1" "\$k6 == \$mk6"
gdb_test "print \$k7 == \$mk7" "\\$\\d+ = 1" "\$k7 == \$mk7"

# Check that we still have run control
#
gdb_test "break" "Breakpoint 2 .*$srcfile2, line 4." "set breakpoint to validate run control"
gdb_test "continue" ".*volatile int bp.*" "continue to breakpoint to validate run control"

gdb_exit
offload_cleanup
