# Test goals: check that registers can be read and written

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
#
gdb_test_no_output "set var loop = 1" "set var loop = 1"

# delete all breakpoints
#
delete_breakpoints

# Read register and save value, write in register, check value, restore value and check it
# (for general purpose registers)
gdb_test "info reg \$rax" "rax\\s+0x\[0-9a-f\]+.*" "info reg \$rax => <value> "
gdb_test "info reg \$rbx" "rbx\\s+0x\[0-9a-f\]+.*" "info reg \$rbx => <value> "
gdb_test "info reg \$rcx" "rcx\\s+0x\[0-9a-f\]+.*" "info reg \$rcx => <value> "
gdb_test "info reg \$rdx" "rdx\\s+0x\[0-9a-f\]+.*" "info reg \$rdx => <value> "
gdb_test "info reg \$rsi" "rsi\\s+0x\[0-9a-f\]+.*" "info reg \$rsi => <value> "
gdb_test "info reg \$rdi" "rdi\\s+0x\[0-9a-f\]+.*" "info reg \$rdi => <value> "
gdb_test "info reg \$rbp" "rbp\\s+0x\[0-9a-f\]+.*" "info reg \$rbp => <value> "
gdb_test "info reg \$rsp" "rsp\\s+0x\[0-9a-f\]+.*" "info reg \$rsp => <value> "
gdb_test "info reg \$r8" "r8\\s+0x\[0-9a-f\]+.*" "info reg \$r8 => <value> "
gdb_test "info reg \$r9" "r9\\s+0x\[0-9a-f\]+.*" "info reg \$r9 => <value> "
gdb_test "info reg \$r10" "r10\\s+0x\[0-9a-f\]+.*" "info reg \$r10 => <value> "
gdb_test "info reg \$r11" "r11\\s+0x\[0-9a-f\]+.*" "info reg \$r11 => <value> "
gdb_test "info reg \$r12" "r12\\s+0x\[0-9a-f\]+.*" "info reg \$r12 => <value> "
gdb_test "info reg \$r13" "r13\\s+0x\[0-9a-f\]+.*" "info reg \$r13 => <value> "
gdb_test "info reg \$r14" "r14\\s+0x\[0-9a-f\]+.*" "info reg \$r14 => <value> "
gdb_test "info reg \$r15" "r15\\s+0x\[0-9a-f\]+.*" "info reg \$r15 => <value> "
gdb_test "info reg \$rip" "rip\\s+0x\[0-9a-f\]+.*" "info reg \$rip => <value> "
gdb_test "info reg \$eflags" "eflags\\s+0x\[0-9a-f\]+.*" "info reg \$eflags => <value> "
gdb_test "info reg \$cs" "cs\\s+0x\[0-9a-f\]+.*" "info reg \$cs => <value> "
gdb_test "info reg \$ss" "ss\\s+0x\[0-9a-f\]+.*" "info reg \$ss => <value> "
gdb_test "info reg \$ds" "ds\\s+0x\[0-9a-f\]+.*" "info reg \$ds => <value> "
gdb_test "info reg \$es" "es\\s+0x\[0-9a-f\]+.*" "info reg \$es => <value> "
gdb_test "info reg \$fs" "fs\\s+0x\[0-9a-f\]+.*" "info reg \$fs => <value> "
gdb_test "info reg \$gs" "gs\\s+0x\[0-9a-f\]+.*" "info reg \$gs => <value> "

# Save the content of registers
#
gdb_test_no_output "set var \$mrax = \$rax" "set var \$mrax = \$rax"
gdb_test_no_output "set var \$mrbx = \$rbx" "set var \$mrbx = \$rbx"
gdb_test_no_output "set var \$mrcx = \$rcx" "set var \$mrcx = \$rcx"
gdb_test_no_output "set var \$mrdx = \$rdx" "set var \$mrdx = \$rdx"
gdb_test_no_output "set var \$mrsi = \$rsi" "set var \$mrsi = \$rsi"
gdb_test_no_output "set var \$mrdi = \$rdi" "set var \$mrdi = \$rdi"
gdb_test_no_output "set var \$mrbp = \$rbp" "set var \$mrbp = \$rbp"
gdb_test_no_output "set var \$mrsp = \$rsp" "set var \$mrsp = \$rsp"
gdb_test_no_output "set var \$mr8 = \$r8" "set var \$mr8 = \$r8"
gdb_test_no_output "set var \$mr9 = \$r9" "set var \$mr9 = \$r9"
gdb_test_no_output "set var \$mr10 = \$r10" "set var \$mr10 = \$r10"
gdb_test_no_output "set var \$mr11 = \$r11" "set var \$mr11 = \$r11"
gdb_test_no_output "set var \$mr12 = \$r12" "set var \$mr12 = \$r12"
gdb_test_no_output "set var \$mr13 = \$r13" "set var \$mr13 = \$r13"
gdb_test_no_output "set var \$mr14 = \$r14" "set var \$mr14 = \$r14"
gdb_test_no_output "set var \$mr15 = \$r15" "set var \$mr15 = \$r15"
gdb_test_no_output "set var \$mrip = \$rip" "set var \$mrip = \$rip"
gdb_test_no_output "set var \$meflags = \$eflags" "set var \$meflags = \$eflags"
gdb_test_no_output "set var \$mcs = \$cs" "set var \$mcs = \$cs"
gdb_test_no_output "set var \$mss = \$ss" "set var \$mss = \$ss"
gdb_test_no_output "set var \$mds = \$ds" "set var \$mds = \$ds"
gdb_test_no_output "set var \$mes = \$es" "set var \$mes = \$es"
gdb_test_no_output "set var \$mfs = \$fs" "set var \$mfs = \$fs"
gdb_test_no_output "set var \$mgs = \$gs" "set var \$mgs = \$gs"

# Assign value to register
#
gdb_test_no_output "set var \$rax = 0xf0f0f0f0f0f0f0f0" "set var \$rax = 0xf0f0f0f0f0f0f0f0"
gdb_test_no_output "set var \$rbx = 0x0f0f0f0f0f0f0f0f" "set var \$rbx = 0x0f0f0f0f0f0f0f0f"
gdb_test_no_output "set var \$rcx = 0xe0e0e0e0e0e0e0e0" "set var \$rcx = 0xe0e0e0e0e0e0e0e0"
gdb_test_no_output "set var \$rdx = 0x0e0e0e0e0e0e0e0e" "set var \$rdx = 0x0e0e0e0e0e0e0e0e"
gdb_test_no_output "set var \$rsi = 0xd0d0d0d0d0d0d0d0" "set var \$rsi = 0xd0d0d0d0d0d0d0d0"
gdb_test_no_output "set var \$rdi = 0xd0d0d0d0d0d0d0d0" "set var \$rdi = 0xd0d0d0d0d0d0d0d0"
gdb_test_no_output "set var \$rbp = 0xc0c0c0c0c0c0c0c0" "set var \$rbp = 0xc0c0c0c0c0c0c0c0"
gdb_test_no_output "set var \$rsp = 0x0c0c0c0c0c0c0c0c" "set var \$rsp = 0x0c0c0c0c0c0c0c0c"
gdb_test_no_output "set var \$rip = 0x7070707070707070" "set var \$rip = 0x7070707070707070"
gdb_test_no_output "set var \$r8 = 0xb0b0b0b0b0b0b0b0" "set var \$r8 = 0xb0b0b0b0b0b0b0b0"
gdb_test_no_output "set var \$r9 = 0x0b0b0b0b0b0b0b0b" "set var \$r9 = 0x0b0b0b0b0b0b0b0b"
gdb_test_no_output "set var \$r10 = 0xa0a0a0a0a0a0a0a0" "set var \$r10 = 0xa0a0a0a0a0a0a0a0"
gdb_test_no_output "set var \$r11 = 0x0a0a0a0a0a0a0a0a" "set var \$r11 = 0x0a0a0a0a0a0a0a0a"
gdb_test_no_output "set var \$r12 = 0x9090909090909090" "set var \$r12 = 0x9090909090909090"
gdb_test_no_output "set var \$r13 = 0x0909090909090909" "set var \$r13 = 0x0909090909090909"
gdb_test_no_output "set var \$r14 = 0x8080808080808080" "set var \$r14 = 0x8080808080808080"
gdb_test_no_output "set var \$r15 = 0x0808080808080808" "set var \$r15 = 0x0808080808080808"

# Check that assigned value is corrrect
#

gdb_test "info reg \$rax" "rax\\s+0xf0f0f0f0f0f0f0f0\\s+\[-0-9\]+" "info reg \$rax == 0xf0f0f0f0f0f0f0f0 <value>"
gdb_test "info reg \$rbx" "rbx\\s+0xf0f0f0f0f0f0f0f\\s+\[-0-9\]+" "info reg \$rbx == 0xf0f0f0f0f0f0f0f <value>"
gdb_test "info reg \$rcx" "rcx\\s+0xe0e0e0e0e0e0e0e0\\s+\[-0-9\]+" "info reg \$rcx == 0xe0e0e0e0e0e0e0e0 <value>"
gdb_test "info reg \$rdx" "rdx\\s+0xe0e0e0e0e0e0e0e\\s+\[-0-9\]+" "info reg \$rdx == 0x0e0e0e0e0e0e0e0e <value>"
gdb_test "info reg \$rsi" "rsi\\s+0xd0d0d0d0d0d0d0d0\\s+\[-0-9\]+" "info reg \$rsi == 0xd0d0d0d0d0d0d0d0 <value>"
gdb_test "info reg \$rdi" "rdi\\s+0xd0d0d0d0d0d0d0d0\\s+\[-0-9\]+" "info reg \$rdi == 0x0d0d0d0d0d0d0d0d <value>"
gdb_test "info reg \$rbp" "rbp\\s+0xc0c0c0c0c0c0c0c0\\s+0x\[0-9a-f\]+" "info reg \$rbp == 0xc0c0c0c0c0c0c0c0 <value>"
gdb_test "info reg \$rsp" "rsp\\s+0xc0c0c0c0c0c0c0c\\s+0x\[0-9a-f\]+" "info reg \$rsp == 0x0c0c0c0c0c0c0c0c <value>"
gdb_test "info reg \$rip" "rip\\s+0x7070707070707070\\s+0x\[0-9a-f\]+" "info reg \$rip == 0x7070707070707070 <value>"
gdb_test "info reg \$r8" "r8\\s+0xb0b0b0b0b0b0b0b0\\s+\[-0-9\]+" "info reg \$r8 == 0xb0b0b0b0b0b0b0b0 <value>"
gdb_test "info reg \$r9" "r9\\s+0xb0b0b0b0b0b0b0b\\s+\[-0-9\]+" "info reg \$r9 == 0x0b0b0b0b0b0b0b0b <value>"
gdb_test "info reg \$r10" "r10\\s+0xa0a0a0a0a0a0a0a0\\s+\[-0-9\]+" "info reg \$r10 == 0xa0a0a0a0a0a0a0a0 <value>"
gdb_test "info reg \$r11" "r11\\s+0xa0a0a0a0a0a0a0a\\s+\[-0-9\]+" "info reg \$r11 == 0x0a0a0a0a0a0a0a0a <value>"
gdb_test "info reg \$r12" "r12\\s+0x9090909090909090\\s+\[-0-9\]+" "info reg \$r12 == 0x9090909090909090 <value>"
gdb_test "info reg \$r13" "r13\\s+0x909090909090909\\s+\[-0-9\]+" "info reg \$r13 == 0x0909090909090909 <value>"
gdb_test "info reg \$r14" "r14\\s+0x8080808080808080\\s+\[-0-9\]+" "info reg \$r14 == 0x8080808080808080 <value>"
gdb_test "info reg \$r15" "r15\\s+0x808080808080808\\s+\[-0-9\]+" "info reg \$r15 == 0x0808080808080808 <value>"

# Restore registers
#
gdb_test_no_output "set var \$rax = \$mrax" "set var \$rax = \$mrax"
gdb_test_no_output "set var \$rbx = \$mrbx" "set var \$rbx = \$mrbx"
gdb_test_no_output "set var \$rcx = \$mrcx" "set var \$rcx = \$mrcx"
gdb_test_no_output "set var \$rdx = \$mrdx" "set var \$rdx = \$mrdx"
gdb_test_no_output "set var \$rsi = \$mrsi" "set var \$rsi = \$mrsi"
gdb_test_no_output "set var \$rdi = \$mrdi" "set var \$rdi = \$mrdi"
gdb_test_no_output "set var \$rbp = \$mrbp" "set var \$rbp = \$mrbp"
gdb_test_no_output "set var \$rsp = \$mrsp" "set var \$rsp = \$mrsp"
gdb_test_no_output "set var \$r8 = \$mr8" "set var \$r8 = \$mr8"
gdb_test_no_output "set var \$r9 = \$mr9" "set var \$r9 = \$mr9"
gdb_test_no_output "set var \$r10 = \$mr10" "set var \$r10 = \$mr10"
gdb_test_no_output "set var \$r11 = \$mr11" "set var \$r11 = \$mr11"
gdb_test_no_output "set var \$r12 = \$mr12" "set var \$r12 = \$mr12"
gdb_test_no_output "set var \$r13 = \$mr13" "set var \$r13 = \$mr13"
gdb_test_no_output "set var \$r14 = \$mr14" "set var \$r14 = \$mr14"
gdb_test_no_output "set var \$r15 = \$mr15" "set var \$r15 = \$mr15"
gdb_test_no_output "set var \$rip = \$mrip" "set var \$rip = \$mrip"
gdb_test_no_output "set var \$eflags = \$meflags" "set var \$eflags = \$meflags"
gdb_test_no_output "set var \$cs = \$mcs" "set var \$cs = \$mcs"
gdb_test_no_output "set var \$ss = \$mss" "set var \$ss = \$mss"
gdb_test_no_output "set var \$ds = \$mds" "set var \$ds = \$mds"
gdb_test_no_output "set var \$es = \$mes" "set var \$es = \$mes"
gdb_test_no_output "set var \$fs = \$mfs" "set var \$fs = \$mfs"
gdb_test_no_output "set var \$gs = \$mgs" "set var \$gs = \$mgs"

# Check restored values
#
gdb_test "print \$rax == \$mrax" "\\$\\d+ = 1" "\$rax == \$mrax"
gdb_test "print \$rbx == \$mrbx" "\\$\\d+ = 1" "\$rbx == \$mrbx"
gdb_test "print \$rcx == \$mrcx" "\\$\\d+ = 1" "\$rcx == \$mrcx"
gdb_test "print \$rdx == \$mrdx" "\\$\\d+ = 1" "\$rdx == \$mrdx"
gdb_test "print \$rsi == \$mrsi" "\\$\\d+ = 1" "\$rsi == \$mrsi"
gdb_test "print \$rdi == \$mrdi" "\\$\\d+ = 1" "\$rdi == \$mrdi"
gdb_test "print \$rbp == \$mrbp" "\\$\\d+ = 1" "\$rbp == \$mrbp"
gdb_test "print \$rsp == \$mrsp" "\\$\\d+ = 1" "\$rsp == \$mrsp"
gdb_test "print \$r8 == \$mr8" "\\$\\d+ = 1" "\$r8 == \$mr8"
gdb_test "print \$r9 == \$mr9" "\\$\\d+ = 1" "\$r9 == \$mr9"
gdb_test "print \$r10 == \$mr10" "\\$\\d+ = 1" "\$r10 == \$mr10"
gdb_test "print \$r11 == \$mr11" "\\$\\d+ = 1" "\$r11 == \$mr11"
gdb_test "print \$r12 == \$mr12" "\\$\\d+ = 1" "\$r12 == \$mr12"
gdb_test "print \$r13 == \$mr13" "\\$\\d+ = 1" "\$r13 == \$mr13"
gdb_test "print \$r14 == \$mr14" "\\$\\d+ = 1" r14 == \$mr14"
gdb_test "print \$r15 == \$mr15" "\\$\\d+ = 1" "\$r15 == \$mr15"
gdb_test "print \$rip == \$mrip" "\\$\\d+ = 1" "\$rip == \$mrip"
gdb_test "print \$eflags == \$meflags" "\\$\\d+ = 1" "\$eflags == \$meflags"
gdb_test "print \$cs == \$mcs" "\\$\\d+ = 1" "\$cs == \$mcs"
gdb_test "print \$ss == \$mss" "\\$\\d+ = 1" "\$ss == \$mss"
gdb_test "print \$ds == \$mds" "\\$\\d+ = 1" "\$ds == \$mds"
gdb_test "print \$es == \$mes" "\\$\\d+ = 1" "\$es == \$mes"
gdb_test "print \$fs == \$mfs" "\\$\\d+ = 1" "\$fs == \$mfs"
gdb_test "print \$gs == \$mgs" "\\$\\d+ = 1" "\$gs == \$mgs"

# Check that we still have run control
#
gdb_test "break" "Breakpoint 2 .*$srcfile2, line 4." "set breakpoint to validate run control"
gdb_test "continue" ".*volatile int bp.*" "continue to breakpoint to validate run control"

gdb_exit
offload_cleanup
