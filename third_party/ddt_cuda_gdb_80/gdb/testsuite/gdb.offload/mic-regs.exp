# Test goals: the "info reg" command can be executed and does not crash

load_lib "offload.exp"

standard_testfile "dummy.c" "myo_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

# force to stay in the endless loop
send_gdb "set var loop = 1\n"

# Check general availability of MIC k specific registers
gdb_test "info registers" ".*
\k0.*\[\r\n\]
\k1.*\[\r\n\]
\k2.*\[\r\n\]
\k3.*\[\r\n\]
\k4.*\[\r\n\]
\k5.*\[\r\n\]
\k6.*\[\r\n\]
\k7.*\[\r\n\]" "info registers"

# Check general availability of MIC zmm specific registers
gdb_test "info registers" ".*
\zmm0.*\[\r\n\]
\zmm1.*\[\r\n\]
\zmm2.*\[\r\n\]
\zmm3.*\[\r\n\]
\zmm4.*\[\r\n\]
\zmm5.*\[\r\n\]
\zmm6.*\[\r\n\]
\zmm7.*\[\r\n\]
\zmm8.*\[\r\n\]
\zmm9.*\[\r\n\]
\zmm10.*\[\r\n\]
\zmm11.*\[\r\n\]
\zmm12.*\[\r\n\]
\zmm13.*\[\r\n\]
\zmm14.*\[\r\n\]
\zmm15.*\[\r\n\]
\zmm16.*\[\r\n\]
\zmm17.*\[\r\n\]
\zmm18.*\[\r\n\]
\zmm19.*\[\r\n\]
\zmm20.*\[\r\n\]
\zmm21.*\[\r\n\]
\zmm22.*\[\r\n\]
\zmm23.*\[\r\n\]
\zmm24.*\[\r\n\]
\zmm25.*\[\r\n\]
\zmm26.*\[\r\n\]
\zmm27.*\[\r\n\]
\zmm28.*\[\r\n\]
\zmm29.*\[\r\n\]
\zmm30.*\[\r\n\]
\zmm31.*\[\r\n\]" "info registers"

for {set i 0} {$i < 8} {incr i} {
    gdb_test "info registers k${i}" "\k${i}\\s+0x\[0-9a-f\]+\\t+\[0-9\]+\[\r\n\]" "info registers k${i}"
}

for {set i 0} {$i < 32} {incr i} {
    gdb_test "info registers zmm${i}" "\zmm${i}\\s+\{v16_float =.*v8_double =.*v64_int8 =.*v32_int16 =.*v16_int32 =.*v8_int64 =.*v4_uint128 =.*\}\[\r\n\]" "info registers zmm${i}"
}

gdb_test "break" ".*Breakpoint 2 at .*:.*${srcfile2}, line 4.*" "break"
gdb_test "cont" ".*volatile int bp = 1.*" "cont"

gdb_exit
offload_cleanup
