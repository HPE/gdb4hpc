# Test goals: check the return command

load_lib "offload.exp"

standard_testfile "psample01.c" "pragma_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

# needed for the return command
gdb_test_no_output "set confirm off" "set confirm off"

# BP in function "psample01_f1"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "breakpoint_psample01_f1" "${srcfile}"]"
gdb_continue_to_breakpoint "breakpoint_psample01_f1"

# set the return value directly then return
set zmm0 "\$zmm0\.v16_float\[0\]"
gdb_test_no_output "set var $zmm0=43" "set $zmm0=43"
gdb_test "return" "#0\\s+0x\[0-9a-f\]+.* at .*$srcfile:63.*" "return to line 63"

# we should still be at line 63 now, execute the statement and check the result
gdb_test "next" "64\\s+d = d .*" "next to line 64"
gdb_test "print d" ".* = 42" "d should be 42"

# delete all breakpoints
delete_breakpoints

# BP in function "psample01_f1"
gdb_breakpoint "${srcfile}:[gdb_get_line_number "breakpoint_psample01_f2" "${srcfile}"]"
gdb_continue_to_breakpoint "breakpoint_psample01_f2"

# set the return value directly then return
gdb_test_no_output "set var $zmm0=-84" "set $zmm0=-84"
gdb_test "return" "#0\\s+0x\[0-9a-f\]+.* at .*$srcfile:64.*" "return to line 64"

# we should still be at line 64 now, execute the statement and check the result
gdb_test "next" "66\\s+host_d = d.*" "next => to line 66"
gdb_test "print d" ".* = -42" "d should be -42"

gdb_exit
offload_cleanup
