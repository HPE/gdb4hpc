# Test goals: check the "set" command deferencing a pointer and
#             evaluating the value of the original referenced variable
#             up on the stack frame.

load_lib "offload.exp"

standard_testfile "psample03.c" "pragma_attach_default.c"

if {! [is_remote target]} {
    return
}

if { [skip_offload_test] } {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "pragma"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "breakpoint_at_return" "${srcfile}"]"
gdb_continue_to_breakpoint "breakpoint_at_return"
delete_breakpoints
gdb_test_no_output "set *a=42" "set *a=42"
gdb_test "up" ".*at.*${srcfile}:[gdb_get_line_number "function_call" "${srcfile}"].*" "up"
gdb_test "p val" "\\\$\\d+ = 42" "p val"


gdb_exit
offload_cleanup
