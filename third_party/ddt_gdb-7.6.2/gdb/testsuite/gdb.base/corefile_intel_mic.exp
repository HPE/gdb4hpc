load_lib gdbserver-support.exp

if { [skip_gdbserver_tests] } {
    return 0
}

set testfile "corefile_intel_mic"
set srcfile ${testfile}.c
set binfile ${objdir}/${subdir}/${testfile}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile}" "${binfile}" executable {debug}] != "" } {
    untested corefile_intel_mic.exp
    return -1
}

# Create and source the file that provides information about the compiler
# used to compile the test case.
if [get_compiler_info] {
    return -1;
}

# Upload the debuggee and ...
remote_download target ${binfile}
# ... call it on the target to generate the core dump file.
remote_exec target "./corefile_intel_mic"
# download the core dump file to the host
remote_upload target "./core"

gdb_exit
gdb_start
gdb_reinitialize_dir $srcdir/$subdir
gdb_load ${binfile}

# Make sure we can load the MIC core dump and not crash
gdb_test "core ./core" ".*" "corefile_remote: load core file"
gdb_test "up" ".*abort\.c.*" "corefile_remote: load core file up 1"
gdb_test "up" ".*abort\(\).*" "corefile_remote: load core file up 2"
