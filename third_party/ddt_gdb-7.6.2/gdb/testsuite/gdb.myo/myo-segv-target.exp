load_lib "myo.exp"
set testfile "myo-segv-target"
set srcfile ${testfile}.c
set binfile  ${objdir}/${subdir}/${testfile}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} ${srcdir}/${subdir}/attach_default.c" "${binfile}" executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

myo_initialize $binfile

myo_attach_sequence "c"

set bp_loc [gdb_get_line_number "bp-before-shared-write"]
gdb_test "break ${srcfile}:${bp_loc}" ".*Breakpoint .* at .*: file .*, line ${bp_loc}.*" "set bp @ line ${bp_loc}"
set bp_loc [gdb_get_line_number "bp-before-after-write"]
gdb_test "break ${srcfile}:${bp_loc}" ".*Breakpoint .* at .*: file .*, line ${bp_loc}.*" "set bp @ line ${bp_loc}"
gdb_test "continue" ".*foo = 42;.*" "cont"
# the continue over the shared variable write should not report a SEGV to the user
gdb_test "continue" ".*volatile int bp = 0;.*" "cont"

set bp_loc [gdb_get_line_number "bp-force-segv"]
gdb_test "break ${srcfile}:${bp_loc}" ".*Breakpoint .* at .*: file .*, line ${bp_loc}.*" "set bp @ line ${bp_loc}"
set bp_loc [gdb_get_line_number "bp-after-segv"]
gdb_test "break ${srcfile}:${bp_loc}" ".*Breakpoint .* at .*: file .*, line ${bp_loc}.*" "set bp @ line ${bp_loc}"

gdb_test "continue" ".*0 = 0;.*" "cont"
# continue over the forced SEGV should be reported to the user
gdb_test "continue" ".*Program received signal SIGSEGV, Segmentation fault.*" "cont"

gdb_exit

myo_cleanup
