# Test goals: check evaluations of static data members

load_lib "offload.exp"

standard_testfile "msample07.cpp" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

gdb_breakpoint "${srcfile}:[gdb_get_line_number "localclass_entry" "${srcfile}"]"
gdb_continue_to_breakpoint "localclass_entry"

gdb_test "print MSAMPLE07::no_objs_count" "\\\$\\d+ = 2" "MSAMPLE07::no_objs_count == 2"

# check the value after the construction of the local obj
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "localclass_end" "${srcfile}"]"
gdb_continue_to_breakpoint "localclass_end"

gdb_test "print MSAMPLE07::no_objs_count" "\\\$\\d+ = 3" "MSAMPLE07::no_objs_count == 3"

gdb_exit
offload_cleanup
