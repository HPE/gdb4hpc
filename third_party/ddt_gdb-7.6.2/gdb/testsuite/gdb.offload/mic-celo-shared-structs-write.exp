# Test goals: evaluation and modification of a shared struct

load_lib "offload.exp"

standard_testfile "msample09.c" "myo_attach_default.c"

if { [skip_offload_test] } {
    return
}

if {! [is_remote target]} {
    return
}

if  { [gdb_compile "${srcdir}/${subdir}/${srcfile} \
        ${srcdir}/${subdir}/${srcfile2}" "${binfile}" \
        executable {debug}] != "" } {
    untested "${testfile}.exp"
    return -1
}

offload_initialize $binfile
offload_attach_sequence "myo"

proc check_struct { num } {
    gdb_test "p SCI.sc" "\\\$\\d+ = 0x6e" "$num: SCI.sc == 0x6e"
    gdb_test "p SCI.si" "\\\$\\d+ = 0x6e45f1a8" "$num: SCI.si == 0x6e45f1a8"
    gdb_test "p SCI.sl" "\\\$\\d+ = 0x25bff4832b74cc1dl" "$num: SCI.sl == 0x25bff4832b74cc1dl"
    gdb_test "p SCI.sll" "\\\$\\d+ = 0x32b74cc1de45f177l" "$num: SCI.sll == 0x32b74cc1de45f177l"
    gdb_test "p SCI.f" "\\\$\\d+ = 42.0" "$num: SCI.f == 42.0"
    gdb_test "p SCI.d" "\\\$\\d+ = 42422424.0" "$num: SCI.d == 42422424.0"
    gdb_test "p SCI.ld" "\\\$\\d+ = 1972191120080412.0" "$num: SCI.ld == 1972191120080412.0"
}

gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP2" "${srcfile}"]"
gdb_continue_to_breakpoint "BP2"

gdb_test_no_output "set SCI.sc=0x6e" "set SCI.sc=0x6e"
gdb_test_no_output "set SCI.si=0x6e45f1a8" "set SCI.si=0x6e45f1a8"
gdb_test_no_output "set SCI.sl=0x25bff4832b74cc1dl" "set SCI.sl=0x25bff4832b74cc1dl"
gdb_test_no_output "set SCI.sll=0x32b74cc1de45f177l" "set SCI.sll=0x32b74cc1de45f177l"
gdb_test_no_output "set SCI.f=42.0" "set SCI.f=42.0"
gdb_test_no_output "set SCI.d=42422424.0" "set SCI.d=42422424.0"
gdb_test_no_output "set SCI.ld=1972191120080412.0" "set SCI.ld=1972191120080412.0"

# check the changes in the same offload region
check_struct "1st check"

# go back to host and check again
delete_breakpoints
gdb_breakpoint "${srcfile}:[gdb_get_line_number "BP3" "${srcfile}"]"
gdb_continue_to_breakpoint "BP3"
check_struct "2nd check"

gdb_exit
offload_cleanup
